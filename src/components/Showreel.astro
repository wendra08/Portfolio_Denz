---
const moments = [
  {
    number: "01",
    title: "Akad",
    subtitle: "Sacred Moments",
    video: "/videos/showreel-akad.mp4",
    description:
      "Menjaga suasana akad tetap khidmat, tertib, dan berjalan dengan alur yang nyaman.",
  },
  {
    number: "02",
    title: "Resepsi",
    subtitle: "Celebration",
    video: "/videos/showreel-resepsi.mp4",
    description:
      "Menjaga energi acara, transisi, komunikasi dengan tamu, dan dinamika resepsi.",
  },
  {
    number: "03",
    title: "Entrance",
    subtitle: "Creating Energy",
    video: "/videos/showreel-entrance.mp4",
    description:
      "Membangun momentum dan energi ketika pasangan memasuki salah satu bagian penting wedding.",
  },
];
---

<section
  id="showreel"
  class="relative overflow-hidden bg-charcoal text-ivory"
>
  <!-- BACKGROUND GLOW -->

  <div
    class="pointer-events-none absolute top-1/3 left-1/2 h-[700px] w-[700px] -translate-x-1/2 rounded-full bg-gold/[0.035] blur-[160px]"
    aria-hidden="true"
  ></div>

  <div class="container-luxury py-20 md:py-28 lg:py-32">

    <!-- =====================================
         HEADER
    ====================================== -->

    <div
      class="showreel-reveal grid gap-10 lg:grid-cols-[0.55fr_1.45fr] lg:items-end lg:gap-20"
    >
      <div>
        <div class="flex items-center gap-4">
          <span class="h-px w-10 bg-gold"></span>

          <p class="gold-label">
            Showreel
          </p>
        </div>

        <p
          class="mt-6 max-w-xs text-sm leading-7 text-white/45"
        >
          Selected moments from wedding ceremonies,
          receptions, entrances, and live interactions.
        </p>
      </div>

      <div>
        <h2
          class="max-w-5xl font-serif text-[clamp(3.5rem,7vw,7.5rem)] leading-[0.85] tracking-[-0.05em]"
        >
          Watch Kang Denz <span class="block text-gold">in action.</span>
        </h2>
      </div>
    </div>

    <!-- =====================================
         LANDSCAPE COVER
    ====================================== -->

    <div
      class="showreel-reveal mt-14 md:mt-20"
    >
      <div
        class="group relative overflow-hidden border border-white/10"
      >
        <div
          class="relative aspect-[4/3] overflow-hidden sm:aspect-[16/10] lg:aspect-[16/7]"
        >
          <img
            src="/images/showreel-cover.jpeg"
            alt="Kang Denz Wedding MC showreel"
            class="h-full w-full object-cover transition-transform duration-[1200ms] group-hover:scale-[1.025]"
            loading="lazy"
          />

          <!-- OVERLAYS -->

          <div
            class="absolute inset-0 bg-black/20"
            aria-hidden="true"
          ></div>

          <div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/10"
            aria-hidden="true"
          ></div>

          <div
            class="absolute inset-0 bg-gradient-to-r from-black/40 via-transparent to-transparent"
            aria-hidden="true"
          ></div>

          <!-- CONTENT -->

          <div
            class="absolute right-0 bottom-0 left-0 p-6 md:p-10 lg:p-12"
          >
            <div
              class="flex flex-col gap-6 border-t border-white/20 pt-5 md:flex-row md:items-end md:justify-between"
            >
              <div>
                <p
                  class="text-[8px] font-semibold tracking-[0.28em] text-gold uppercase"
                >
                  Wedding Stories
                </p>

                <p
                  class="mt-2 max-w-2xl font-serif text-2xl leading-tight md:text-4xl lg:text-5xl"
                >
                  Every moment carries
                  its own energy.
                </p>
              </div>

              <a
                href="#selected-moments"
                class="group inline-flex w-fit items-center gap-4 text-[8px] font-semibold tracking-[0.22em] text-white/60 uppercase transition-colors duration-300 hover:text-gold"
              >
                Watch Selected Moments <span
                  class="transition-transform duration-300 group-hover:translate-y-1"
                >
                  ↓
                </span>
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- =====================================
         PHILOSOPHY
    ====================================== -->

    <div
      class="showreel-reveal mt-14 grid gap-8 border-b border-white/10 pb-14 md:mt-20 md:pb-20 lg:grid-cols-[0.45fr_1.55fr]"
    >
      <p
        class="text-[8px] font-semibold tracking-[0.25em] text-gold uppercase"
      >
        The Philosophy
      </p>

      <blockquote
        class="max-w-5xl font-serif text-[clamp(2.3rem,4vw,4.5rem)] leading-[1.02] tracking-[-0.03em] text-ivory-muted"
      >
        “A microphone is just a tool. <span class="text-gold">The real skill is knowing what to say, when to say it, and how to make people feel it.</span>”
      </blockquote>
    </div>

    <!-- =====================================
         SELECTED MOMENTS HEADER
    ====================================== -->

    <div
      id="selected-moments"
      class="showreel-reveal scroll-mt-32 pt-20 md:pt-24"
    >
      <div
        class="grid gap-7 border-b border-white/10 pb-10 md:grid-cols-[0.65fr_1.35fr] md:items-end"
      >
        <div>
          <p
            class="text-[8px] font-semibold tracking-[0.25em] text-gold uppercase"
          >
            Selected Moments
          </p>
        </div>

        <div>
          <h3
            class="max-w-4xl font-serif text-[clamp(2.8rem,5vw,5.5rem)] leading-[0.92] tracking-[-0.04em]"
          >
            Three moments. <span class="text-gold">Three different energies.</span>
          </h3>
        </div>
      </div>
    </div>

    <!-- =====================================
         PORTRAIT VIDEOS
    ====================================== -->

    <div
      class="mt-10 grid gap-12 md:grid-cols-3 md:gap-8 lg:gap-10"
    >
      {
        moments.map((moment) => (
          <article
            class="showreel-reveal group mx-auto w-full max-w-[340px] md:max-w-none"
          >
            <button
              type="button"
              class="showreel-video-card relative block w-full cursor-pointer overflow-hidden border border-white/10 bg-black text-left"
              data-video={moment.video}
              data-title={moment.title}
              data-subtitle={moment.subtitle}
              aria-label={`Play ${moment.title} video`}
            >
              <div
                class="relative aspect-[9/16] overflow-hidden"
              >
                <!-- VIDEO PREVIEW -->

                <video
                  class="showreel-preview h-full w-full bg-black object-contain md:object-cover"
                  muted
                  playsinline
                  preload="metadata"
                >
                  <source
                    src={moment.video}
                    type="video/mp4"
                  />
                </video>

                <!-- OVERLAY -->

                <div
                  class="absolute inset-0 bg-black/15 transition-colors duration-500 group-hover:bg-black/30"
                  aria-hidden="true"
                ></div>

                <div
                  class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-black/10"
                  aria-hidden="true"
                ></div>

                <!-- NUMBER -->

                <div
                  class="absolute top-5 left-5"
                >
                  <p
                    class="text-[8px] font-semibold tracking-[0.22em] text-white/55"
                  >
                    {moment.number}
                  </p>
                </div>

                <!-- PLAY -->

                <div
                  class="absolute inset-0 flex items-center justify-center"
                >
                  <span
                    class="flex h-16 w-16 items-center justify-center rounded-full border border-white/40 bg-black/25 text-sm text-white backdrop-blur-md transition-all duration-500 group-hover:scale-110 group-hover:border-gold group-hover:bg-gold group-hover:text-charcoal"
                  >
                    ▶
                  </span>
                </div>

                <!-- LABEL -->

                <div
                  class="absolute right-0 bottom-0 left-0 p-5 md:p-6"
                >
                  <div
                    class="border-t border-white/20 pt-4"
                  >
                    <p
                      class="text-[7px] font-semibold tracking-[0.22em] text-gold uppercase"
                    >
                      {moment.subtitle}
                    </p>

                    <h4
                      class="mt-2 font-serif text-3xl text-white md:text-4xl"
                    >
                      {moment.title}
                    </h4>
                  </div>
                </div>
              </div>
            </button>

            <p
              class="mt-5 text-sm leading-7 text-white/45"
            >
              {moment.description}
            </p>
          </article>
        ))
      }
    </div>

  </div>
</section>

<!-- =====================================
     VIDEO MODAL
====================================== -->

<div
  id="showreel-modal"
  data-open="false"
  class="fixed inset-0 z-[200] flex items-center justify-center bg-black/95 p-4 opacity-0 backdrop-blur-xl md:p-8"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <!-- CLOSE -->

  <button
    id="showreel-close"
    type="button"
    class="absolute top-5 right-5 z-30 flex h-11 w-11 items-center justify-center rounded-full border border-white/20 text-xl text-white transition-all duration-300 hover:border-gold hover:bg-gold hover:text-charcoal md:top-8 md:right-8"
    aria-label="Close video"
  >
    ×
  </button>

  <!-- MODAL INNER -->

  <div
    class="grid max-h-[92dvh] w-full max-w-5xl gap-8 overflow-y-auto md:grid-cols-[0.75fr_1.25fr] md:items-center md:gap-12"
  >
    <!-- VIDEO -->

    <div
      class="mx-auto w-full max-w-[360px]"
    >
      <div
        class="aspect-[9/16] overflow-hidden bg-black"
      >
        <video
          id="showreel-modal-video"
          class="h-full w-full object-contain"
          controls
          playsinline
          preload="metadata"
        ></video>
      </div>
    </div>

    <!-- INFORMATION -->

    <div class="pb-5 md:pb-0">
      <p
        class="text-[8px] font-semibold tracking-[0.25em] text-gold uppercase"
      >
        Selected Moment
      </p>

      <h3
        id="showreel-modal-title"
        class="mt-4 font-serif text-5xl tracking-[-0.04em] text-ivory md:text-7xl"
      >
        Akad
      </h3>

      <p
        id="showreel-modal-subtitle"
        class="mt-3 text-[9px] font-semibold tracking-[0.22em] text-white/35 uppercase"
      >
        Sacred Moments
      </p>

      <div
        class="mt-8 h-px w-full bg-white/10"
      ></div>

      <p
        class="mt-8 max-w-lg font-serif text-2xl leading-snug text-ivory-muted md:text-3xl"
      >
        Real wedding moments.
        Real interactions.
        Real situations.
      </p>

      <p
        class="mt-6 max-w-md text-sm leading-7 text-white/45"
      >
        Setiap wedding memiliki suasana yang berbeda.
        Pembawaan Kang Denz menyesuaikan momentum,
        karakter pasangan, tamu, dan jalannya acara.
      </p>
    </div>
  </div>
</div>

<script>
  function setupShowreel() {
    /* ========================================
       GET ELEMENTS
    ========================================= */

    const modal =
      document.querySelector<HTMLElement>(
        "#showreel-modal"
      );

    const closeButton =
      document.querySelector<HTMLButtonElement>(
        "#showreel-close"
      );

    const modalVideo =
      document.querySelector<HTMLVideoElement>(
        "#showreel-modal-video"
      );

    const modalTitle =
      document.querySelector<HTMLElement>(
        "#showreel-modal-title"
      );

    const modalSubtitle =
      document.querySelector<HTMLElement>(
        "#showreel-modal-subtitle"
      );

    const cards =
      document.querySelectorAll<HTMLButtonElement>(
        ".showreel-video-card"
      );

    /* ========================================
       VALIDATION
    ========================================= */

    if (
      !modal ||
      !closeButton ||
      !modalVideo ||
      !modalTitle ||
      !modalSubtitle
    ) {
      return;
    }

    const safeModal = modal;
    const safeCloseButton = closeButton;
    const safeModalVideo = modalVideo;
    const safeModalTitle = modalTitle;
    const safeModalSubtitle = modalSubtitle;

    /* Prevent duplicate initialization */

    if (
      modal.dataset.initialized === "true"
    ) {
      return;
    }

    modal.dataset.initialized = "true";

    /* ========================================
       OPEN MODAL
    ========================================= */

    function openModal(
      videoSource: string,
      title: string,
      subtitle: string
    ) {
      safeModalVideo.src = videoSource;

      safeModalTitle.textContent = title;

      safeModalSubtitle.textContent =
        subtitle;

      safeModal.dataset.open = "true";

      safeModal.setAttribute(
        "aria-hidden",
        "false"
      );

      document.body.style.overflow =
        "hidden";

      safeModalVideo.load();

      safeModalVideo
        .play()
        .catch(() => {
          /*
           * Browser may block autoplay.
           * User can still press play manually.
           */
        });
    }

    /* ========================================
       CLOSE MODAL
    ========================================= */

    function closeModal() {
      safeModal.dataset.open = "false";

      safeModal.setAttribute(
        "aria-hidden",
        "true"
      );

      document.body.style.overflow = "";

      safeModalVideo.pause();

      safeModalVideo.currentTime = 0;

      safeModalVideo.removeAttribute(
        "src"
      );

      safeModalVideo.load();
    }

    /* ========================================
       VIDEO CARDS
    ========================================= */

    cards.forEach((card) => {
      const preview =
        card.querySelector<HTMLVideoElement>(
          ".showreel-preview"
        );

      /* ----------------------------------------
         DESKTOP HOVER PREVIEW
      ----------------------------------------- */

      card.addEventListener(
        "mouseenter",
        () => {
          if (!preview) {
            return;
          }

          preview
            .play()
            .catch(() => {
              /*
               * Ignore autoplay restriction.
               */
            });
        }
      );

      card.addEventListener(
        "mouseleave",
        () => {
          if (!preview) {
            return;
          }

          preview.pause();

          preview.currentTime = 0;
        }
      );

      /* ----------------------------------------
         OPEN VIDEO
      ----------------------------------------- */

      card.addEventListener(
        "click",
        () => {
          const videoSource =
            card.dataset.video;

          const title =
            card.dataset.title ?? "";

          const subtitle =
            card.dataset.subtitle ?? "";

          if (!videoSource) {
            return;
          }

          openModal(
            videoSource,
            title,
            subtitle
          );
        }
      );
    });

    /* ========================================
       CLOSE BUTTON
    ========================================= */

    safeCloseButton.addEventListener(
      "click",
      closeModal
    );

    /* ========================================
       CLICK OUTSIDE MODAL
    ========================================= */

    safeModal.addEventListener(
      "click",
      (event) => {
        if (
          event.target === safeModal
        ) {
          closeModal();
        }
      }
    );

    /* ========================================
       ESCAPE KEY
    ========================================= */

    document.addEventListener(
      "keydown",
      (event) => {
        if (
          event.key === "Escape" &&
          safeModal.dataset.open === "true"
        ) {
          closeModal();
        }
      }
    );

    /* ========================================
       REVEAL ANIMATION
    ========================================= */

    const revealElements =
      document.querySelectorAll<HTMLElement>(
        ".showreel-reveal"
      );

    if (
      !(
        "IntersectionObserver" in
        window
      )
    ) {
      revealElements.forEach(
        (element) => {
          element.classList.add(
            "is-visible"
          );
        }
      );

      return;
    }

    const observer =
      new IntersectionObserver(
        (entries) => {
          entries.forEach(
            (entry) => {
              if (
                !entry.isIntersecting
              ) {
                return;
              }

              const target =
                entry.target;

              if (
                target instanceof HTMLElement
              ) {
                target.classList.add(
                  "is-visible"
                );
              }

              observer.unobserve(
                entry.target
              );
            }
          );
        },
        {
          threshold: 0.08,

          rootMargin:
            "0px 0px -40px 0px",
        }
      );

    revealElements.forEach(
      (element) => {
        observer.observe(element);
      }
    );
  }

  setupShowreel();

  document.addEventListener(
    "astro:page-load",
    setupShowreel
  );
</script>