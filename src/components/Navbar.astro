---
const navItems = [
  {
    label: "About",
    href: "#about",
  },
  {
    label: "Wedding MC",
    href: "#wedding-mc",
  },
  {
    label: "Portfolio",
    href: "#portfolio",
  },
  {
    label: "Nata Manten",
    href: "#nata-manten",
  },
  {
    label: "Natsume",
    href: "#natsume",
  },
  {
    label: "MC Class",
    href: "#mc-class",
  },
];
---

<!-- =======================================
     HEADER
======================================== -->

<header
  id="site-header"
  data-scrolled="false"
  class="fixed top-0 left-0 z-[120] w-full"
>
  <div
    class="container-luxury flex h-20 items-center justify-between md:h-24"
  >

    <!-- ===================================
         BRAND
    ==================================== -->

    <a
      href="#home"
      class="flex flex-col"
      aria-label="Kang Denz Home"
    >
      <span
        class="font-serif text-xl leading-none tracking-[0.08em] text-ivory md:text-2xl"
      >
        KANG DENZ
      </span>

      <span
        class="mt-1 text-[7px] font-semibold tracking-[0.27em] text-gold uppercase md:text-[8px]"
      >
        Professional Wedding MC
      </span>
    </a>

    <!-- ===================================
         DESKTOP NAVIGATION
    ==================================== -->

    <nav
      class="hidden items-center gap-7 xl:flex"
      aria-label="Main navigation"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="nav-link text-[9px] font-semibold tracking-[0.16em] text-white/70 uppercase transition-colors duration-300 hover:text-gold"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- ===================================
         DESKTOP BOOK NOW
    ==================================== -->

    <a
      href="#booking"
      class="hidden border border-gold/70 px-6 py-3 text-[9px] font-bold tracking-[0.2em] text-gold uppercase transition-all duration-300 hover:bg-gold hover:text-charcoal xl:inline-flex"
    >
      Book Now
    </a>

    <!-- ===================================
         MOBILE BUTTON
    ==================================== -->

    <button
      id="mobile-menu-button"
      type="button"
      class="flex h-10 w-10 flex-col items-center justify-center gap-[5px] xl:hidden"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span
        data-menu-line="1"
        class="block h-px w-6 bg-ivory transition-all duration-300"
      ></span>

      <span
        data-menu-line="2"
        class="block h-px w-6 bg-ivory transition-all duration-300"
      ></span>
    </button>

  </div>
</header>

<!-- =======================================
     MOBILE MENU
======================================== -->

<div
  id="mobile-menu"
  data-open="false"
  class="fixed inset-0 z-[110] pointer-events-none invisible opacity-0 transition-all duration-500 xl:hidden"
>

  <!-- BACKDROP -->

    <button
        id="mobile-menu-backdrop"
        type="button"
        class="absolute inset-0 z-0 h-full w-full cursor-default bg-black/70 backdrop-blur-sm"
        aria-label="Close navigation menu"
    ></button>

  <!-- ===================================
       DRAWER
  ==================================== -->

    <div
        id="mobile-menu-drawer"
        class="absolute top-0 right-0 z-10 flex h-dvh w-[88%] max-w-[380px] flex-col border-l border-white/10 bg-charcoal shadow-2xl"
    >

    <!-- DECORATIVE GLOW -->

    <div
      class="pointer-events-none absolute top-0 right-0 h-[400px] w-[400px] translate-x-1/3 -translate-y-1/3 rounded-full bg-gold/5 blur-[120px]"
      aria-hidden="true"
    ></div>

    <!-- DRAWER CONTENT -->

    <div
      class="relative flex h-full flex-col overflow-y-auto px-7 pt-28 pb-7"
    >

      <!-- LABEL -->

      <p
        class="text-[8px] font-semibold tracking-[0.3em] text-gold uppercase"
      >
        Navigation
      </p>

      <!-- MENU -->

      <nav
        class="mt-8 flex flex-col"
        aria-label="Mobile navigation"
      >
        {
          navItems.map((item, index) => (
            <a
              href={item.href}
              data-mobile-link
              class="group flex items-center border-b border-white/10 py-4 text-ivory transition-colors duration-300 hover:text-gold"
            >
              <span
                class="mr-5 font-sans text-[8px] tracking-[0.15em] text-white/30"
              >
                {String(index + 1).padStart(2, "0")}
              </span>

              <span
                class="font-serif text-[clamp(1.9rem,8vw,2.8rem)] leading-none"
              >
                {item.label}
              </span>
            </a>
          ))
        }
      </nav>

      <!-- BOTTOM -->

      <div class="mt-auto pt-8">

        <!-- CTA -->

        <a
          href="#booking"
          data-mobile-link
          class="group flex w-full items-center justify-between bg-gold px-6 py-5 text-[9px] font-bold tracking-[0.2em] text-charcoal uppercase transition-colors duration-300 hover:bg-gold-light"
        >
          <span>
            Book Kang Denz
          </span>

          <span
            class="transition-transform duration-300 group-hover:translate-x-1"
          >
            →
          </span>
        </a>

        <!-- META -->

        <div
          class="mt-6 flex items-center justify-between gap-4 text-[7px] tracking-[0.15em] text-white/30 uppercase"
        >
          <span>
            Professional Wedding MC
          </span>

          <span class="shrink-0">
            Since 2017
          </span>
        </div>

      </div>

    </div>
  </div>
</div>

<!-- =======================================
     CLIENT SCRIPT
======================================== -->

<script>
  function initializeNavbar() {
    const header =
      document.querySelector("#site-header");

    const button =
      document.querySelector("#mobile-menu-button");

    const menu =
      document.querySelector("#mobile-menu");

    const backdrop =
      document.querySelector("#mobile-menu-backdrop");

    if (
      !(header instanceof HTMLElement) ||
      !(button instanceof HTMLButtonElement) ||
      !(menu instanceof HTMLElement)
    ) {
      return;
    }

    const menuButton = button;
    const menuElement = menu;

    /*
     * Prevent duplicate listeners
     * when Astro page navigation
     * is enabled later.
     */

    if (header.dataset.initialized === "true") {
      return;
    }

    header.dataset.initialized = "true";

    const line1 = menuButton.querySelector(
      '[data-menu-line="1"]'
    );

    const line2 = menuButton.querySelector(
      '[data-menu-line="2"]'
    );

    const mobileLinks = menuElement.querySelectorAll(
      "[data-mobile-link]"
    );

    /* =====================================
       SET MOBILE MENU STATE
    ====================================== */

    function setMenuState(open: boolean) {
      menuElement.dataset.open = String(open);

      menuButton.setAttribute(
        "aria-expanded",
        String(open)
      );

      menuButton.setAttribute(
        "aria-label",
        open
          ? "Close navigation menu"
          : "Open navigation menu"
      );

      /*
       * Lock page scrolling
       * while drawer is open.
       */

      document.body.style.overflow =
        open ? "hidden" : "";

      /*
       * Hamburger → X
       */

      if (
        line1 instanceof HTMLElement &&
        line2 instanceof HTMLElement
      ) {
        line1.style.transform = open
          ? "translateY(3px) rotate(45deg)"
          : "";

        line2.style.transform = open
          ? "translateY(-3px) rotate(-45deg)"
          : "";
      }
    }

    /* =====================================
       TOGGLE MENU
    ====================================== */

    menuButton.addEventListener("click", () => {
      const open =
        menuElement.dataset.open === "true";

      setMenuState(!open);
    });

    /* =====================================
       BACKDROP CLICK
    ====================================== */

    backdrop?.addEventListener(
      "click",
      () => {
        setMenuState(false);
      }
    );

    /* =====================================
       CLOSE AFTER LINK CLICK
    ====================================== */

    mobileLinks.forEach((link) => {
      link.addEventListener(
        "click",
        () => {
          setMenuState(false);
        }
      );
    });

    /* =====================================
       ESCAPE BUTTON
    ====================================== */

    document.addEventListener(
      "keydown",
      (event) => {
        if (
          event.key === "Escape" &&
          menuElement.dataset.open === "true"
        ) {
          setMenuState(false);
        }
      }
    );

    /* =====================================
       CLOSE WHEN RESIZING TO DESKTOP
    ====================================== */

    window.addEventListener(
      "resize",
      () => {
        if (
          window.innerWidth >= 1280 &&
          menuElement.dataset.open === "true"
        ) {
          setMenuState(false);
        }
      }
    );

    /* =====================================
       NAVBAR SCROLL EFFECT
    ====================================== */

    function updateNavbar() {
      if (!(header instanceof HTMLElement)) {
        return;
      }

      header.dataset.scrolled = String(
        window.scrollY > 40
      );
    }

    window.addEventListener(
      "scroll",
      updateNavbar,
      {
        passive: true,
      }
    );

    updateNavbar();
  }

  initializeNavbar();

  document.addEventListener(
    "astro:page-load",
    initializeNavbar
  );
</script>