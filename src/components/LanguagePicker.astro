<button id="language-switch" type="button" aria-label="Ubah bahasa" data-no-translate>
  <span lang="id">ID</span><span aria-hidden="true"> / </span><span lang="en">EN</span>
</button>

<dialog id="language-picker" aria-labelledby="language-title" data-no-translate>
  <div class="language-card">
    <p class="language-brand">KANG DENZ</p>
    <span class="language-line" aria-hidden="true"></span>
    <h2 id="language-title"><span lang="id">Selamat datang.</span><br /><span lang="en">Welcome.</span></h2>
    <p class="language-description"><span lang="id">Pilih bahasa untuk melanjutkan.</span><br /><span lang="en">Choose your language to continue.</span></p>
    <aside class="language-booking-note">
      <p lang="id"><strong>Membuka dari TikTok?</strong> Untuk booking melalui WhatsApp, buka website ini lewat Chrome, Safari, atau browser lainnya. Ketuk menu di pojok kanan atas TikTok, lalu pilih <strong>Buka di browser</strong> sebelum mengisi form. Browser TikTok dapat meminta instalasi WhatsApp meskipun WhatsApp biasa atau Business sudah terpasang.</p>
      <p lang="en"><strong>Visiting from TikTok?</strong> To book via WhatsApp, open this website in Chrome, Safari, or another browser. Tap TikTok’s top-right menu and choose <strong>Open in browser</strong> before filling in the form. TikTok’s browser may ask you to install WhatsApp even if WhatsApp or WhatsApp Business is already installed.</p>
      <button id="copy-website-link" type="button"><span lang="id">Salin Link Website</span><span lang="en">Copy Website Link</span></button>
      <p id="copy-website-status" role="status" aria-live="polite"></p>
      <input id="website-link-fallback" type="text" value="https://kangdenz.my.id/" readonly hidden aria-label="Link website / Website link" />
    </aside>
    <div class="language-options">
      <button type="button" data-language="id" lang="id"><span>Bahasa Indonesia</span><span aria-hidden="true">→</span></button>
      <button type="button" data-language="en" lang="en"><span>English</span><span aria-hidden="true">→</span></button>
    </div>
  </div>
</dialog>

<style>
  #language-switch { position: fixed; z-index: 125; right: max(1rem, env(safe-area-inset-right)); top: 5.4rem; border: 1px solid #b79b6280; border-radius: 999px; min-height: 44px; padding: 0.65rem 1rem; background: #11110f; color: #f4f0e7; font-size: 11px; letter-spacing: 0.08em; cursor: pointer; }
  #language-switch:hover { border-color: #b79b62; }
  :global(html[lang="id"]) #language-switch [lang="id"], :global(html[lang="en"]) #language-switch [lang="en"] { color: #c9b27e; font-weight: 700; }
  #language-picker { position: fixed; inset: 0; width: 100%; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 1.5rem; border: 0; background: #11110f; color: #f4f0e7; overflow-y: auto; }
  #language-picker[open] { display: grid; place-items: center; }
  #language-picker::backdrop { background: #11110f; }
  .language-card { width: 100%; max-width: 480px; padding-block: 2rem; }
  .language-brand { color: #b79b62; font-size: 12px; letter-spacing: 0.3em; }
  .language-line { display: block; width: 40px; height: 1px; background: #b79b62; margin-block: 2rem; }
  h2 { font-family: var(--font-serif); font-size: clamp(2.8rem, 8vw, 4.5rem); line-height: 1.05; }
  h2 [lang="en"] { color: #b79b62; }
  .language-description { margin-top: 1.5rem; font-size: 14px; line-height: 1.9; color: #d8d2c6; }
  .language-options { display: grid; gap: 1rem; margin-top: 2rem; }
  .language-booking-note { margin-top: 1.5rem; padding: 1rem; border-left: 2px solid #b79b62; background: #191916; color: #d8d2c6; font-size: 12px; line-height: 1.7; }
  .language-booking-note strong { color: #c9b27e; font-weight: 600; }
  .language-booking-note p + p { margin-top: 0.75rem; }
  #copy-website-link { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem 0.75rem; width: 100%; min-height: 44px; margin-top: 1rem; padding: 0.75rem; border: 1px solid #b79b6280; border-radius: 4px; color: #c9b27e; cursor: pointer; }
  #copy-website-link:hover { background: #b79b621a; }
  #copy-website-link [lang="en"] { color: #d8d2c6; }
  #copy-website-status:empty { display: none; }
  #copy-website-status { margin-top: 0.75rem; }
  #website-link-fallback { width: 100%; margin-top: 0.75rem; padding: 0.75rem; border: 1px solid #b79b6280; background: #11110f; color: #f4f0e7; font-size: 16px; }
  .language-options button { display: flex; justify-content: space-between; gap: 1rem; padding: 1.2rem 1.4rem; border: 1px solid #b79b6266; background: #191916; color: #f4f0e7; text-align: left; cursor: pointer; }
  .language-options button:hover { background: #b79b62; color: #11110f; }
  button:focus-visible { outline: 2px solid #c9b27e; outline-offset: 4px; }
  :global(html:has(#language-picker[open])) { overflow: hidden; }
  :global(body:has(#mobile-menu[data-open="true"])) #language-switch { visibility: hidden; }
  @media (min-width: 768px) { #language-switch { right: 2rem; top: 6.4rem; } }
  @media print { #language-switch, #language-picker { display: none !important; } }
</style>

<script>
  import { setLanguage, translate, watchTranslations, type Language } from '../i18n/client';
  function initializeLanguage() {
    const dialog = document.querySelector<HTMLDialogElement>('#language-picker');
    const switcher = document.querySelector<HTMLButtonElement>('#language-switch');
    if (!dialog || !switcher || dialog.dataset.ready) return;
    dialog.dataset.ready = 'true';
    const copyLink = dialog.querySelector<HTMLButtonElement>('#copy-website-link');
    const copyStatus = dialog.querySelector<HTMLParagraphElement>('#copy-website-status');
    const linkFallback = dialog.querySelector<HTMLInputElement>('#website-link-fallback');
    copyLink?.addEventListener('click', async () => {
      if (!copyStatus || !linkFallback) return;
      try {
        await navigator.clipboard.writeText(linkFallback.value);
        copyStatus.textContent = 'Link berhasil disalin. Tempel di Chrome atau Safari. / Link copied. Paste it into Chrome or Safari.';
        linkFallback.hidden = true;
      } catch {
        linkFallback.hidden = false;
        linkFallback.focus();
        linkFallback.select();
        linkFallback.setSelectionRange(0, linkFallback.value.length);
        copyStatus.textContent = 'Tekan lama link di bawah lalu pilih Salin. / Press and hold the link below, then choose Copy.';
      }
    });
    let chosen = false;
    watchTranslations();
    dialog.showModal();
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        chosen = false;
        if (!dialog.open) dialog.showModal();
      }
    });
    dialog.addEventListener('cancel', (event) => { if (!chosen) event.preventDefault(); });
    switcher.addEventListener('click', () => dialog.showModal());
    dialog.querySelectorAll<HTMLButtonElement>('[data-language]').forEach((button) => {
      button.addEventListener('click', () => {
        chosen = true;
        setLanguage(button.dataset.language as Language);
        dialog.close();
        switcher.focus({ preventScroll: true });
      });
    });
    const label = () => switcher.setAttribute('aria-label', translate('Ubah bahasa'));
    document.addEventListener('site:language-change', label);
    label();
  }
  initializeLanguage();
  document.addEventListener('astro:page-load', initializeLanguage);
</script>
