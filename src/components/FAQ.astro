</section>

<script>
  function initializeFAQ() {
    const section =
      document.querySelector<HTMLElement>(
        "#faq"
      );

    if (!section) {
      return;
    }

    if (
      section.dataset.initialized ===
      "true"
    ) {
      return;
    }

    section.dataset.initialized =
      "true";

    /* =====================================
       REVEAL
    ====================================== */

    const revealElements =
      section.querySelectorAll<HTMLElement>(
        ".faq-reveal"
      );

    if (
      "IntersectionObserver" in
      window
    ) {
      const observer =
        new IntersectionObserver(
          (entries) => {
            entries.forEach(
              (entry) => {
                if (
                  !entry.isIntersecting
                ) {
                  return;
                }

                if (
                  entry.target instanceof
                  HTMLElement
                ) {
                  entry.target.classList.add(
                    "is-visible"
                  );
                }

                observer.unobserve(
                  entry.target
                );
              }
            );
          },
          {
            threshold: 0.08,
            rootMargin:
              "0px 0px -40px 0px",
          }
        );

      revealElements.forEach(
        (element) => {
          observer.observe(
            element
          );
        }
      );
    } else {
      revealElements.forEach(
        (element) => {
          element.classList.add(
            "is-visible"
          );
        }
      );
    }

    /* =====================================
       ELEMENTS
    ====================================== */

    const categories =
      section.querySelectorAll<HTMLButtonElement>(
        ".faq-category"
      );

    const items =
      section.querySelectorAll<HTMLElement>(
        ".faq-item"
      );

    /* =====================================
       CLOSE ITEM
    ====================================== */

    function closeItem(
      item: HTMLElement
    ) {
      const button =
        item.querySelector<HTMLButtonElement>(
          ".faq-question"
        );

      const answer =
        item.querySelector<HTMLElement>(
          ".faq-answer"
        );

      if (!button || !answer) {
        return;
      }

      button.setAttribute(
        "aria-expanded",
        "false"
      );

      answer.setAttribute(
        "aria-hidden",
        "true"
      );

      answer.style.maxHeight =
        "0px";

      item.dataset.open =
        "false";
    }

    /* =====================================
       OPEN ITEM
    ====================================== */

    function openItem(
      item: HTMLElement
    ) {
      const button =
        item.querySelector<HTMLButtonElement>(
          ".faq-question"
        );

      const answer =
        item.querySelector<HTMLElement>(
          ".faq-answer"
        );

      if (!button || !answer) {
        return;
      }

      /* only one open */

      items.forEach(
        (currentItem) => {
          if (
            currentItem !== item &&
            !currentItem.hidden
          ) {
            closeItem(
              currentItem
            );
          }
        }
      );

      button.setAttribute(
        "aria-expanded",
        "true"
      );

      answer.setAttribute(
        "aria-hidden",
        "false"
      );

      answer.style.maxHeight =
        `${answer.scrollHeight}px`;

      item.dataset.open =
        "true";
    }

    /* =====================================
       QUESTION CLICK
    ====================================== */

    items.forEach((item) => {
      const button =
        item.querySelector<HTMLButtonElement>(
          ".faq-question"
        );

      if (!button) {
        return;
      }

      closeItem(item);

      button.addEventListener(
        "click",
        () => {
          const isOpen =
            item.dataset.open ===
            "true";

          if (isOpen) {
            closeItem(item);

            return;
          }

          openItem(item);
        }
      );
    });

    /* =====================================
       CATEGORY FILTER
    ====================================== */

    categories.forEach(
      (categoryButton) => {
        categoryButton.addEventListener(
          "click",
          () => {
            const selectedCategory =
              categoryButton
                .dataset.category;

            if (
              !selectedCategory
            ) {
              return;
            }

            categories.forEach(
              (button) => {
                button.dataset.active =
                  button ===
                  categoryButton
                    ? "true"
                    : "false";
              }
            );

            const visibleItems:
              HTMLElement[] = [];

            items.forEach(
              (item) => {
                closeItem(item);

                const matches =
                  item.dataset
                    .faqCategory ===
                  selectedCategory;

                item.hidden =
                  !matches;

                if (matches) {
                  visibleItems.push(
                    item
                  );
                }
              }
            );

            /*
              Open first FAQ
              automatically.
            */

            if (
              visibleItems.length >
              0
            ) {
              requestAnimationFrame(
                () => {
                  openItem(
                    visibleItems[0]
                  );
                }
              );
            }
          }
        );
      }
    );

    /* =====================================
       OPEN FIRST WEDDING QUESTION
    ====================================== */

    const firstVisible =
      Array.from(items).find(
        (item) =>
          !item.hidden
      );

    if (firstVisible) {
      requestAnimationFrame(
        () => {
          openItem(
            firstVisible
          );
        }
      );
    }
  }

  initializeFAQ();

  document.addEventListener(
    "astro:page-load",
    initializeFAQ
  );
</script>
