          </p>
        </div>
      </div>
    </div>

    <!-- =====================================
         PRIMARY WHATSAPP CTA
    ====================================== -->

    <div
      class="contact-reveal py-14 md:py-20"
    >
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="contact-primary group relative block overflow-hidden border border-gold/35 px-7 py-8 transition-all duration-500 md:px-10 md:py-10 lg:px-12"
      >
        <div
          class="relative z-10 flex flex-col gap-8 md:flex-row md:items-center md:justify-between"
        >
          <div
            class="flex items-center gap-6"
          >
            <!-- ICON -->

            <span
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-gold/40 text-[10px] font-bold tracking-[0.08em] text-gold transition-all duration-500 group-hover:bg-gold group-hover:text-charcoal md:h-16 md:w-16"
            >
              WA
            </span>

            <div>
              <p
                class="text-[10px] font-bold tracking-[0.22em] text-gold uppercase"
              >
                Direct Conversation
              </p>

              <p
                class="mt-2 font-serif text-3xl leading-none md:text-4xl lg:text-5xl"
              >
                Chat Kang Denz
              </p>

              <p
                class="mt-3 text-[10px] tracking-[0.14em] text-white/60"
              >
                +62 813-1321-6466
              </p>
            </div>
          </div>

          <!-- ARROW -->

          <span
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-white/15 text-xl text-white/50 transition-all duration-500 group-hover:translate-x-1 group-hover:border-gold group-hover:text-gold"
            aria-hidden="true"
          >
            ↗
          </span>
        </div>
      </a>
    </div>

    <!-- =====================================
         CONTACT CHANNELS
    ====================================== -->

    <div
      class="contact-reveal border-t border-white/10"
    >
      {
        contacts.map((contact) => (
          contact.url ? (

            <a
              href={contact.url}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-channel group relative grid gap-5 border-b border-white/10 py-7 md:grid-cols-[70px_1fr_1fr_auto] md:items-center md:gap-8 md:py-9"
