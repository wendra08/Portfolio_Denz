    </div>

    <!-- =====================================
         FINAL BRAND STATEMENT
    ====================================== -->

    <div
      class="contact-reveal mt-20 border-t border-white/10 pt-14 md:mt-28 md:pt-20"
    >
      <div
        class="grid gap-10 lg:grid-cols-[0.45fr_1.55fr] lg:items-end"
      >
