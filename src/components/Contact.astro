            >
              <p
                class="text-[10px] font-bold tracking-[0.16em] text-white/60"
              >
                {contact.number}
              </p>

              <div
                class="flex items-center gap-5"
              >
                <span
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 text-[10px] font-bold text-white/60"
                >
                  {contact.code}
                </span>

                <p
                  class="font-serif text-2xl text-white/50 md:text-3xl"
                >
                  {contact.name}
                </p>
              </div>

              <p
                class="text-sm text-white/60"
              >
                {contact.detail}
              </p>

              <span
                class="text-[10px] font-bold tracking-[0.18em] text-white/60 uppercase"
