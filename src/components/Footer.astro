---
const currentYear = new Date().getFullYear();

const whatsappUrl =
  "https://wa.me/6281313216466?text=Halo%20Kang%20Denz%2C%20saya%20ingin%20bertanya%20mengenai%20layanan%20Kang%20Denz.";

const navigation = [
  {
    label: "Home",
    href: "/",
  },
  {
    label: "About Denz",
    href: "/#about",
  },
  {
    label: "Wedding MC",
    href: "/#wedding-mc",
  },
  {
    label: "Portfolio",
    href: "/#portfolio",
  },
  {
    label: "Journal",
    href: "/journal",
  },
  {
    label: "Contact",
    href: "/#contact",
  },
];

const services = [
  {
    label: "Wedding MC",
    href: "/#wedding-mc",
  },
  {
    label: "Nata Manten",
    href: "/#nata-manten",
  },
  {
    label: "Natsume Photo",
    href: "/#natsume",
  },
  {
    label: "MC Class",
    href: "/#mc-class",
  },
];

const socials = [
  {
    label: "WhatsApp",
    href: whatsappUrl,
    active: true,
  },
  {
    label: "Instagram",
    href: "",
    active: false,
  },
  {
    label: "TikTok",
    href: "",
    active: false,
  },
  {
    label: "Facebook",
    href: "",
    active: false,
  },
];
---

<footer
  class="relative overflow-hidden border-t border-white/10 bg-[#0b0b09] text-ivory"
>
  <!-- DECORATIVE -->

  <div
    class="pointer-events-none absolute -bottom-[300px] left-1/2 h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-gold/[0.025] blur-[160px]"
    aria-hidden="true"
  ></div>

  <div
    class="container-luxury relative z-10"
  >
    <!-- =====================================
         MAIN FOOTER
    ====================================== -->

    <div
      class="grid gap-14 py-16 md:py-20 lg:grid-cols-[1.35fr_0.65fr_0.65fr_0.65fr] lg:gap-12 lg:py-24"
    >
      <!-- =====================================
           BRAND
      ====================================== -->

      <div>
        <a
          href="/"
          class="footer-brand inline-block"
          aria-label="Kang Denz Home"
        >
          <p
            class="text-[10px] font-bold tracking-[0.25em] text-gold uppercase"
          >
            Muhamad Denny Hidayat, S.Pd
          </p>

          <p
            class="mt-3 font-serif text-[clamp(2.75rem,6vw,6.5rem)] leading-[0.78] tracking-[-0.055em]"
          >
            Kang{" "}<span class="text-gold">Denz.</span>
          </p>
        </a>

        <p
          class="mt-7 max-w-md text-sm leading-7 text-white/60"
        >
          Professional Wedding MC yang memahami
          sebuah wedding bukan hanya dari atas
          panggung, tetapi juga dari sisi planning,
          coordination, dan documentation.
        </p>

        <!-- MINI TAGLINE -->

        <div
          class="mt-8 border-l border-gold/40 pl-5"
        >
          <p
            class="max-w-sm font-serif text-xl leading-snug text-white/70 md:text-2xl"
          >
            More than just speaking.
          </p>

          <p
            class="font-serif text-xl leading-snug text-gold md:text-2xl"
          >
            It's about understanding the moment.
          </p>
        </div>

        <!-- BOOK -->

        <a
          href="/#booking"
          class="group mt-9 inline-flex items-center gap-4"
        >
          <span
            class="text-[10px] font-bold tracking-[0.2em] text-ivory uppercase transition-colors duration-300 group-hover:text-gold"
          >
            Book Kang Denz
          </span>

          <span
            class="text-gold transition-transform duration-300 group-hover:translate-x-1"
          >
            →
          </span>
        </a>
      </div>

      <!-- =====================================
           NAVIGATION
      ====================================== -->

      <div>
        <p
          class="footer-heading"
        >
          Explore
        </p>

        <nav
          class="mt-6 flex flex-col items-start gap-4"
          aria-label="Footer navigation"
        >
          {
            navigation.map((item) => (
              <a
                href={item.href}
                class="footer-link"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>

      <!-- =====================================
           SERVICES
      ====================================== -->

      <div>
        <p
          class="footer-heading"
        >
          Services
        </p>

        <div
          class="mt-6 flex flex-col items-start gap-4"
        >
          {
            services.map((item) => (
              <a
                href={item.href}
                class="footer-link"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <!-- =====================================
           CONNECT
      ====================================== -->

      <div>
        <p
          class="footer-heading"
        >
          Connect
        </p>

        <div
          class="mt-6 flex flex-col items-start gap-4"
        >
          {
            socials.map((social) => (
              social.active ? (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="footer-link"
                >
                  <span
                    class="flex items-center gap-3"
                  >
                    {social.label}

                    <span
                      class="text-[10px] text-gold"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                  </span>
                </a>
              ) : (
                <div
                  class="flex items-center gap-3 text-sm text-white/60"
                >
                  <span>
                    {social.label}
                  </span>

                  <span
                    class="text-[10px] font-bold tracking-[0.16em] text-white/60 uppercase"
                  >
                    Soon
                  </span>
                </div>
              )
            ))
          }
        </div>

        <!-- WHATSAPP NUMBER -->

        <div
          class="mt-8 border-t border-white/10 pt-6"
        >
          <p
            class="text-[10px] font-bold tracking-[0.18em] text-white/60 uppercase"
          >
            WhatsApp
          </p>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-block font-serif text-xl text-white/60 transition-colors duration-300 hover:text-gold"
          >
            +62 813-1321-6466
          </a>
        </div>
      </div>
    </div>

    <!-- =====================================
         DIVIDER
    ====================================== -->

    <div
      class="h-px bg-white/10"
    ></div>

    <!-- =====================================
         BOTTOM BAR
    ====================================== -->

    <div
      class="flex flex-col gap-6 py-7 md:flex-row md:items-center md:justify-between"
    >
      <div
        class="flex flex-col gap-2 md:flex-row md:items-center md:gap-5"
      >
        <p
          class="text-[10px] tracking-[0.15em] text-white/60 uppercase"
        >
          © {currentYear} Kang Denz.
          All rights reserved.
        </p>

        <span
          class="hidden h-1 w-1 rounded-full bg-white/20 md:block"
        ></span>

        <p
          class="text-[10px] tracking-[0.15em] text-white/60 uppercase"
        >
          Professional Wedding MC
        </p>
      </div>

      <!-- BACK TO TOP -->

      <button
        id="footer-back-top"
        type="button"
        class="group flex items-center gap-4 self-start md:self-auto"
        aria-label="Back to top"
      >
        <span
          class="text-[10px] font-bold tracking-[0.18em] text-white/60 uppercase transition-colors duration-300 group-hover:text-gold"
        >
          Back To Top
        </span>

        <span
          class="flex h-8 w-8 items-center justify-center rounded-full border border-white/10 text-xs text-white/60 transition-all duration-300 group-hover:border-gold group-hover:bg-gold group-hover:text-charcoal"
          aria-hidden="true"
        >
          ↑
        </span>
      </button>
    </div>
  </div>
</footer>

<script>
  function initializeFooter() {
    const button =
      document.querySelector<HTMLButtonElement>(
        "#footer-back-top"
      );

    if (!button) {
      return;
    }

    if (
      button.dataset.initialized ===
      "true"
    ) {
      return;
    }

    button.dataset.initialized =
      "true";

    button.addEventListener(
      "click",
      () => {
        window.scrollTo({
          top: 0,
          behavior:
            window.matchMedia(
              "(prefers-reduced-motion: reduce)"
            ).matches
              ? "auto"
              : "smooth",
        });
      }
    );
  }

  initializeFooter();

  document.addEventListener(
    "astro:page-load",
    initializeFooter
  );
</script>