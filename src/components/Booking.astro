---
const services = [
  {
    number: "01",
    value: "Book Kang Denz",
    title: "Book Kang Denz",
    subtitle: "Professional Wedding MC",
    description:
      "Wedding MC / Lamaran / Akad / Resepsi / Event by Request",
  },

  {
    number: "02",
    value: "Nata Manten",
    title: "Nata Manten",
    subtitle: "Wedding Planner",
    description:
      "Wedding Planning / Wedding Coordination / Wedding Day Management",
  },

  {
    number: "03",
    value: "Natsume Photo",
    title: "Natsume Photo",
    subtitle: "Photography & Studio",
    description:
      "Wedding Photography / Prewedding / Studio / Documentation",
  },

  {
    number: "04",
    value: "MC Class",
    title: "MC Class",
    subtitle: "Private MC Mentoring",
    description:
      "Private 1-on-1 Mentoring / Public Speaking / MC Practice",
  },
];

const eventTypes = [
  "Lamaran",
  "Akad",
  "Resepsi",
  "Wedding",
  "Wedding Planning",
  "Wedding Coordination",
  "Prewedding",
  "Photography",
  "Studio Photography",
  "Event Documentation",
  "Private MC Mentoring",
  "Event by Request",
  "Lainnya",
];

const directWhatsapp =
  "https://wa.me/6281313216466?text=Halo%20Kang%20Denz%2C%20saya%20ingin%20bertanya%20mengenai%20layanan%20Kang%20Denz.";
---

<section
  id="booking"
  class="relative overflow-hidden bg-charcoal text-ivory pt-16 md:pt-24 lg:pt-28"
>
  <!-- =====================================
       DECORATIVE BACKGROUND
  ====================================== -->

  <div
    class="pointer-events-none absolute -top-[300px] right-[-220px] h-[800px] w-[800px] rounded-full bg-gold/[0.04] blur-[180px]"
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute -bottom-[350px] left-[-250px] h-[800px] w-[800px] rounded-full bg-gold/[0.025] blur-[190px]"
    aria-hidden="true"
  ></div>

  <div
    class="container-luxury py-8 md:py-12 lg:py-14"
  >
    <!-- =====================================
         HEADER
    ====================================== -->

    <div
      class="booking-reveal border-b border-white/10 pb-14 md:pb-20"
    >
      <div
        class="flex items-center gap-4"
      >
        <span
          class="h-px w-10 bg-gold"
        ></span>

        <p class="gold-label">
          Booking
        </p>
      </div>

      <div
        class="mt-8 grid gap-10 lg:grid-cols-[1.25fr_0.75fr] lg:items-end lg:gap-20"
      >
        <!-- HEADLINE -->

        <div>
          <p
            class="text-[8px] font-semibold tracking-[0.24em] text-white/30 uppercase"
          >
            Let's Start The Conversation
          </p>

          <h2
            class="mt-5 max-w-6xl font-serif text-[clamp(3.8rem,7vw,7.5rem)] leading-[0.82] tracking-[-0.04em]"
            style="word-spacing: 0.08em;"
          >
            What can we&nbsp;<span class="text-gold">help you with?</span>
          </h2>
        </div>

        <!-- DESCRIPTION -->

        <div>
          <p
            class="max-w-md text-sm leading-7 text-white/45 md:text-base md:leading-8"
          >
            Ceritakan rencana acara, tanggal,
            lokasi, serta layanan yang dibutuhkan.
            Detail yang kamu berikan akan membantu
            proses komunikasi menjadi lebih cepat
            dan terarah.
          </p>
        </div>
      </div>
    </div>

    <!-- =====================================
         SERVICE SELECTION
    ====================================== -->

    <div
      class="booking-reveal mt-14 md:mt-20"
    >
      <div
        class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between"
      >
        <div>
          <p
            class="text-[8px] font-bold tracking-[0.22em] text-gold uppercase"
          >
            Step 01
          </p>

          <h3
            class="mt-3 font-serif text-3xl tracking-[-0.03em] md:text-4xl"
          >
            Choose a service
          </h3>
        </div>

        <p
          class="text-[8px] tracking-[0.17em] text-white/25 uppercase"
        >
          Select one service
        </p>
      </div>

      <!-- SERVICE GRID -->

      <div
        class="mt-8 grid gap-3 md:grid-cols-2 lg:grid-cols-4"
      >
        {
          services.map((service, index) => (
            <label
              class="booking-service group relative cursor-pointer"
            >
              <input
                type="radio"
                name="service"
                value={service.value}
                class="peer sr-only"
                form="booking-form"
                required={index === 0}
              />

              <span
                class="flex h-full min-h-[260px] flex-col justify-between border border-white/10 bg-white/[0.02] p-6 transition-all duration-500 hover:border-gold/60 hover:bg-white/[0.04] peer-checked:border-gold peer-checked:bg-gold/[0.08] md:p-7"
              >
                <!-- TOP -->

                <span
                  class="flex items-start justify-between gap-5"
                >
                  <span
                    class="font-serif text-xl text-white/25 transition-colors duration-300 group-hover:text-gold peer-checked:text-gold"
                  >
                    {service.number}
                  </span>

                  <span
                    class="booking-check flex h-8 w-8 items-center justify-center rounded-full border border-white/15 text-[10px] text-transparent transition-all duration-300"
                    aria-hidden="true"
                  >
                    ✓
                  </span>
                </span>

                <!-- CONTENT -->

                <span>
                  <span
                    class="text-[7px] font-bold tracking-[0.2em] text-gold uppercase"
                  >
                    {service.subtitle}
                  </span>

                  <span
                    class="mt-3 block font-serif text-3xl leading-[0.95] tracking-[-0.035em] md:text-4xl"
                  >
                    {service.title}
                  </span>

                  <span
                    class="mt-5 block text-xs leading-6 text-white/35"
                  >
                    {service.description}
                  </span>
                </span>
              </span>
            </label>
          ))
        }
      </div>
    </div>

    <!-- =====================================
         FORM
    ====================================== -->

    <div
      class="booking-reveal mt-20 border-t border-white/10 pt-14 md:mt-28 md:pt-20"
    >
      <div
        class="grid gap-12 lg:grid-cols-[0.55fr_1.45fr] lg:gap-20"
      >
        <!-- FORM INTRO -->

        <div>
          <p
            class="text-[8px] font-bold tracking-[0.22em] text-gold uppercase"
          >
            Step 02
          </p>

          <h3
            class="mt-4 max-w-md font-serif text-[clamp(2.8rem,4vw,4.8rem)] leading-[0.9] tracking-[-0.03em]"
            style="word-spacing: 0.07em;"
          >
            Tell us about&nbsp;<span class="text-gold">your moment.</span>
          </h3>

          <p
            class="mt-7 max-w-sm text-sm leading-7 text-white/40"
          >
            Isi informasi yang sudah diketahui.
            Jika ada detail yang belum pasti,
            bisa dijelaskan melalui kolom pesan.
          </p>

          <!-- CONTACT -->

          <div
            class="mt-10 border-t border-white/10 pt-7"
          >
            <p
              class="text-[7px] font-bold tracking-[0.2em] text-white/25 uppercase"
            >
              Prefer direct conversation?
            </p>

            <a
              href={directWhatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="group mt-4 inline-flex items-center gap-4"
            >
              <span
                class="flex h-10 w-10 items-center justify-center rounded-full border border-gold/40 text-[9px] font-bold text-gold transition-all duration-300 group-hover:bg-gold group-hover:text-charcoal"
              >
                WA
              </span>

              <span>
                <span
                  class="block font-serif text-xl text-ivory transition-colors group-hover:text-gold"
                >
                  +62 813-1321-6466
                </span>

                <span
                  class="mt-1 block text-[7px] tracking-[0.17em] text-white/25 uppercase"
                >
                  Chat Kang Denz
                </span>
              </span>
            </a>
          </div>
        </div>

        <!-- =====================================
             BOOKING FORM
        ====================================== -->

        <form
          id="booking-form"
          class="grid gap-x-6 gap-y-8 md:grid-cols-2"
        >
          <!-- NAME -->

          <div class="booking-field md:col-span-2">
            <label
              for="booking-name"
              class="booking-label"
            >
              Nama
            </label>

            <input
              id="booking-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Nama lengkap"
              class="booking-input"
            />
          </div>

          <!-- DATE -->

          <div class="booking-field">
            <label
              for="booking-date"
              class="booking-label"
            >
              Tanggal Acara
            </label>

            <input
              id="booking-date"
              name="date"
              type="date"
              required
              class="booking-input booking-date"
            />
          </div>

          <!-- TIME -->

          <div class="booking-field">
            <label
              for="booking-time"
              class="booking-label"
            >
              Jam Acara
            </label>

            <input
              id="booking-time"
              name="time"
              type="time"
              required
              class="booking-input"
            />
          </div>

          <!-- EVENT TYPE -->

          <div class="booking-field">
            <label
              for="booking-event"
              class="booking-label"
            >
              Jenis Acara
            </label>

            <select
              id="booking-event"
              name="event"
              required
              class="booking-input booking-select"
            >
              <option value="">
                Pilih jenis acara
              </option>

              {
                eventTypes.map((eventType) => (
                  <option value={eventType}>
                    {eventType}
                  </option>
                ))
              }
            </select>
          </div>

          <!-- GUEST -->

          <div class="booking-field">
            <label
              for="booking-guests"
              class="booking-label"
            >
              Jumlah Tamu
            </label>

            <input
              id="booking-guests"
              name="guests"
              type="number"
              min="1"
              inputmode="numeric"
              placeholder="Contoh: 500"
              class="booking-input"
            />
          </div>

          <!-- LOCATION -->

          <div
            class="booking-field md:col-span-2"
          >
            <label
              for="booking-location"
              class="booking-label"
            >
              Lokasi
            </label>

            <input
              id="booking-location"
              name="location"
              type="text"
              required
              autocomplete="street-address"
              placeholder="Venue / Kota / Lokasi acara"
              class="booking-input"
            />
          </div>

          <!-- MESSAGE -->

          <div
            class="booking-field md:col-span-2"
          >
            <label
              for="booking-message"
              class="booking-label"
            >
              Pesan / Detail Acara
            </label>

            <textarea
              id="booking-message"
              name="message"
              rows="5"
              placeholder="Ceritakan konsep acara, kebutuhan khusus, atau informasi lainnya..."
              class="booking-input booking-textarea"
            ></textarea>
          </div>

          <!-- =====================================
               ACTION
          ====================================== -->

          <div
            class="md:col-span-2 mt-2 border-t border-white/10 pt-8"
          >
            <div
              class="flex flex-col gap-4 md:flex-row md:items-center"
            >
              <!-- SUBMIT -->

              <button
                type="submit"
                class="group inline-flex min-h-[54px] items-center justify-center gap-5 bg-gold px-8 py-4 text-[9px] font-bold tracking-[0.2em] uppercase transition-all duration-300 hover:bg-gold-light"
              >
                <span
                  style="color: #11110f;"
                >
                  Send Booking Request
                </span>

                <span
                  style="color: #11110f;"
                  class="transition-transform duration-300 group-hover:translate-x-1"
                >
                  →
                </span>
              </button>

              <!-- DIRECT WHATSAPP -->

              <a
                href={directWhatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex min-h-[54px] items-center justify-center gap-5 border border-white/15 px-8 py-4 text-[9px] font-bold tracking-[0.2em] uppercase transition-all duration-300 hover:border-gold hover:bg-white/[0.03]"
              >
                <span
                  style="color: #f4f0e7;"
                  class="transition-colors duration-300 group-hover:text-[#b79b62]"
                >
                  Chat Via WhatsApp
                </span>

                <span
                  style="color: #f4f0e7;"
                  class="transition-all duration-300 group-hover:translate-x-1 group-hover:text-[#b79b62]"
                >
                  ↗
                </span>
              </a>
            </div>

            <p
              class="mt-5 max-w-xl text-[7px] leading-5 tracking-[0.08em] text-white/20"
            >
              Data dari form akan dirangkai menjadi
              pesan WhatsApp dan tidak disimpan di website.
            </p>

            <!-- FORM STATUS -->

            <p
              id="booking-status"
              class="mt-4 hidden text-[8px] font-semibold tracking-[0.15em] text-gold uppercase"
              role="status"
              aria-live="polite"
            ></p>
          </div>
        </form>
      </div>
    </div>

    <!-- =====================================
         CLOSING STATEMENT
    ====================================== -->

    <div
      class="booking-reveal mt-20 border-t border-white/10 pt-12 md:mt-28 md:pt-16"
    >
      <div
        class="grid gap-8 lg:grid-cols-[0.55fr_1.45fr] lg:items-end"
      >
        <p
          class="text-[8px] font-bold tracking-[0.24em] text-gold uppercase"
        >
          Your Moment Starts Here
        </p>

        <p
          class="max-w-5xl font-serif text-[clamp(2.8rem,5vw,5.7rem)] leading-[0.9] tracking-[-0.03em]"
          style="word-spacing: 0.07em;"
        >
          Every great moment starts&nbsp;<span class="text-gold">with a conversation.</span>
        </p>
      </div>
    </div>

  </div>
</section>

<script>
  function initializeBooking() {
    const section =
      document.querySelector<HTMLElement>(
        "#booking"
      );

    if (!section) {
      return;
    }

    if (
      section.dataset.initialized ===
      "true"
    ) {
      return;
    }

    section.dataset.initialized =
      "true";

    /* =====================================
       REVEAL
    ====================================== */

    const revealElements =
      section.querySelectorAll<HTMLElement>(
        ".booking-reveal"
      );

    if (
      "IntersectionObserver" in window
    ) {
      const observer =
        new IntersectionObserver(
          (entries) => {
            entries.forEach(
              (entry) => {
                if (
                  !entry.isIntersecting
                ) {
                  return;
                }

                if (
                  entry.target instanceof
                  HTMLElement
                ) {
                  entry.target.classList.add(
                    "is-visible"
                  );
                }

                observer.unobserve(
                  entry.target
                );
              }
            );
          },
          {
            threshold: 0.08,

            rootMargin:
              "0px 0px -40px 0px",
          }
        );

      revealElements.forEach(
        (element) => {
          observer.observe(
            element
          );
        }
      );
    } else {
      revealElements.forEach(
        (element) => {
          element.classList.add(
            "is-visible"
          );
        }
      );
    }

    /* =====================================
       DATE MINIMUM
    ====================================== */

    const dateInput =
      section.querySelector<HTMLInputElement>(
        "#booking-date"
      );

    if (dateInput) {
      const now = new Date();

      const localDate =
        new Date(
          now.getTime() -
            now.getTimezoneOffset() *
              60000
        )
          .toISOString()
          .slice(0, 10);

      dateInput.min = localDate;
    }

    /* =====================================
       FORM
    ====================================== */

    const form =
      section.querySelector<HTMLFormElement>(
        "#booking-form"
      );

    const status =
      section.querySelector<HTMLElement>(
        "#booking-status"
      );

    if (!form) {
      return;
    }

    form.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();

        if (!form.reportValidity()) {
          return;
        }

        const data =
          new FormData(form);

        const service =
          String(
            data.get("service") ?? ""
          );

        const name =
          String(
            data.get("name") ?? ""
          );

        const date =
          String(
            data.get("date") ?? ""
          );

        const time =
          String(
            data.get("time") ?? ""
          );

        const eventType =
          String(
            data.get("event") ?? ""
          );

        const guests =
          String(
            data.get("guests") ?? ""
          );

        const location =
          String(
            data.get("location") ?? ""
          );

        const message =
          String(
            data.get("message") ?? ""
          );

        if (!service) {
          status?.classList.remove(
            "hidden"
          );

          if (status) {
            status.textContent =
              "Silakan pilih layanan terlebih dahulu.";
          }

          return;
        }

        /* =====================================
           HUMAN READABLE DATE
        ====================================== */

        let formattedDate = date;

        if (date) {
          const dateObject =
            new Date(
              `${date}T00:00:00`
            );

          formattedDate =
            new Intl.DateTimeFormat(
              "id-ID",
              {
                day: "numeric",
                month: "long",
                year: "numeric",
              }
            ).format(dateObject);
        }

        /* =====================================
           WHATSAPP MESSAGE
        ====================================== */

        const lines = [
          "Halo Kang Denz, saya ingin melakukan booking melalui website.",
          "",
          "*BOOKING REQUEST*",
          "",
          `Layanan: ${service}`,
          `Nama: ${name}`,
          `Tanggal Acara: ${formattedDate}`,
          `Jenis Acara: ${eventType}`,
          `Lokasi: ${location}`,
          `Jam Acara: ${time}`,
          `Jumlah Tamu: ${
            guests || "-"
          }`,
          "",
          "*Detail Acara:*",
          message || "-",
          "",
          "Mohon informasinya mengenai availability dan detail layanan. Terima kasih.",
        ];

        const whatsappMessage =
          lines.join("\n");

        const whatsappUrl =
          `https://wa.me/6281313216466?text=${encodeURIComponent(
            whatsappMessage
          )}`;

        if (status) {
          status.textContent =
            "Membuka WhatsApp...";

          status.classList.remove(
            "hidden"
          );
        }

        window.open(
          whatsappUrl,
          "_blank",
          "noopener,noreferrer"
        );
      }
    );
  }

  initializeBooking();

  document.addEventListener(
    "astro:page-load",
    initializeBooking
  );
</script>
