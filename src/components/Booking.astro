---
const services = [
  {
    number: "01",
    value: "Book Kang Denz",
    title: "Book Kang Denz",
    subtitle: "Professional Wedding MC",
    description:
      "MC Lamaran / MC Akad / MC Resepsi / MC Intimate Wedding / MC Event",
  },

  {
    number: "02",
    value: "Nata Manten",
    title: "Nata Manten",
    subtitle: "Wedding Planner",
    description:
      "Wedding Planning / Wedding Coordination / Wedding Day Management",
  },

  {
    number: "03",
    value: "Natsume Photo",
    title: "Natsume Photo",
    subtitle: "Photography & Studio",
    description:
      "Wedding Photography / Prewedding / Studio / Documentation",
  },

  {
    number: "04",
    value: "MC Class",
    title: "MC Class",
    subtitle: "Private Mentoring & Small Class",
    description:
      "Private Mentoring / Private Intensive / Small Class",
  },
];

const eventTypes = [
  "Lamaran",
  "Akad Only",
  "Akad & Resepsi",
  "Intimate Wedding",
];

const directWhatsapp =
  "https://wa.me/6281313216466?text=Halo%20Kang%20Denz%2C%20saya%20ingin%20bertanya%20mengenai%20layanan%20Kang%20Denz.";
---

<section
  id="booking"
  class="relative overflow-hidden bg-charcoal text-ivory pt-16 md:pt-24 lg:pt-28"
>
  <!-- =====================================
       DECORATIVE BACKGROUND
  ====================================== -->

  <div
    class="pointer-events-none absolute -top-[300px] right-[-220px] h-[800px] w-[800px] rounded-full bg-gold/[0.04] blur-[180px]"
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute -bottom-[350px] left-[-250px] h-[800px] w-[800px] rounded-full bg-gold/[0.025] blur-[190px]"
    aria-hidden="true"
  ></div>

  <div
    class="container-luxury py-8 md:py-12 lg:py-14"
  >
    <!-- =====================================
         HEADER
    ====================================== -->

    <div
      class="booking-reveal border-b border-white/10 pb-14 md:pb-20"
    >
      <div
        class="flex items-center gap-4"
      >
        <span
          class="h-px w-10 bg-gold"
        ></span>

        <p class="gold-label">
          Booking
        </p>
      </div>

      <div
        class="mt-8 grid gap-10 lg:grid-cols-[1.25fr_0.75fr] lg:items-end lg:gap-20"
      >
        <!-- HEADLINE -->

        <div>
          <p
            class="text-[10px] font-semibold tracking-[0.24em] text-white/60 uppercase"
          >
            Let's Start The Conversation
          </p>

          <h2
            class="mt-5 max-w-6xl font-serif text-[clamp(2.75rem,7vw,7.5rem)] leading-[0.82] tracking-[-0.04em]"
            style="word-spacing: 0.08em;"
          >
            What can we{" "}<span class="text-gold">help you with?</span>
          </h2>
        </div>

        <!-- DESCRIPTION -->

        <div>
          <p
            class="max-w-md text-sm leading-7 text-white/60 md:text-base md:leading-8"
          >
            Ceritakan rencana acara, tanggal,
            lokasi, serta layanan yang dibutuhkan.
            Detail yang kamu berikan akan membantu
            proses komunikasi menjadi lebih cepat
            dan terarah.
          </p>
        </div>
      </div>
    </div>

    <!-- =====================================
         SERVICE SELECTION
    ====================================== -->

    <div
      class="booking-reveal mt-14 md:mt-20"
    >
      <div
        class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between"
      >
        <div>
          <p
            class="text-[10px] font-bold tracking-[0.22em] text-gold uppercase"
          >
            Step 01
          </p>

          <h3
            class="mt-3 font-serif text-3xl tracking-[-0.03em] md:text-4xl"
          >
            Choose a service
          </h3>
        </div>

        <p
          class="text-[10px] tracking-[0.17em] text-white/60 uppercase"
        >
          Select one service
        </p>
      </div>

      <!-- SERVICE GRID -->

      <div
        class="mt-8 grid gap-3 md:grid-cols-2 lg:grid-cols-4"
      >
        {
          services.map((service, index) => (
            <label
              class="booking-service group relative cursor-pointer"
            >
              <input
                type="radio"
                name="service"
                value={service.value}
                class="peer sr-only"
                form="booking-form"
                required={index === 0}
              />

              <span
                class="flex h-full min-h-[260px] flex-col justify-between border border-white/10 bg-white/[0.02] p-6 transition-all duration-500 hover:border-gold/60 hover:bg-white/[0.04] peer-checked:border-gold peer-checked:bg-gold/[0.08] md:p-7"
              >
                <!-- TOP -->

                <span
                  class="flex items-start justify-between gap-5"
                >
                  <span
                    class="font-serif text-xl text-white/60 transition-colors duration-300 group-hover:text-gold peer-checked:text-gold"
                  >
                    {service.number}
                  </span>

                  <span
                    class="booking-check flex h-8 w-8 items-center justify-center rounded-full border border-white/15 text-[10px] text-transparent transition-all duration-300"
                    aria-hidden="true"
                  >
                    ✓
                  </span>
                </span>

                <!-- CONTENT -->

                <span>
                  <span
                    class="text-[10px] font-bold tracking-[0.2em] text-gold uppercase"
                  >
                    {service.subtitle}
                  </span>

                  <span
                    class="mt-3 block font-serif text-3xl leading-[0.95] tracking-[-0.035em] md:text-4xl"
                  >
                    {service.title}
                  </span>

                  <span
                    class="mt-5 block text-xs leading-6 text-white/60"
                  >
                    {service.description}
                  </span>
                </span>
              </span>
            </label>
          ))
        }
      </div>
    </div>

    <!-- =====================================
         FORM
    ====================================== -->

    <div
      class="booking-reveal mt-20 border-t border-white/10 pt-14 md:mt-28 md:pt-20"
    >
      <div
        class="grid gap-12 lg:grid-cols-[0.55fr_1.45fr] lg:gap-20"
      >
        <!-- FORM INTRO -->

        <div>
          <p
            class="text-[10px] font-bold tracking-[0.22em] text-gold uppercase"
          >
            Step 02
          </p>

          <h3
            class="mt-4 max-w-md font-serif text-[clamp(2.8rem,4vw,4.8rem)] leading-[0.9] tracking-[-0.03em]"
            style="word-spacing: 0.07em;"
          >
            Tell us about{" "}<span class="text-gold">your moment.</span>
          </h3>

          <p
            class="mt-7 max-w-sm text-sm leading-7 text-white/60"
          >
            Isi informasi yang sudah diketahui.
            Jika ada detail yang belum pasti,
            bisa dijelaskan melalui kolom pesan.
          </p>

          <!-- CONTACT -->

          <div
            class="mt-10 border-t border-white/10 pt-7"
          >
            <p
              class="text-[10px] font-bold tracking-[0.2em] text-white/60 uppercase"
            >
              Prefer direct conversation?
            </p>

            <a
              href={directWhatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="group mt-4 inline-flex items-center gap-4"
            >
              <span
                class="flex h-10 w-10 items-center justify-center rounded-full border border-gold/40 text-[10px] font-bold text-gold transition-all duration-300 group-hover:bg-gold group-hover:text-charcoal"
              >
                WA
              </span>

              <span>
                <span
                  class="block font-serif text-xl text-ivory transition-colors group-hover:text-gold"
                >
                  +62 813-1321-6466
                </span>

                <span
                  class="mt-1 block text-[10px] tracking-[0.17em] text-white/60 uppercase"
                >
                  Chat Kang Denz
                </span>
              </span>
            </a>
          </div>
        </div>

        <!-- =====================================
             BOOKING FORM
        ====================================== -->

        <form
          id="booking-form"
          class="grid gap-x-6 gap-y-8 md:grid-cols-2"
        >
          <!-- NAME -->

          <div class="booking-field md:col-span-2">
            <label
              for="booking-name"
              class="booking-label"
            >
              Nama
            </label>

            <input
              id="booking-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Nama lengkap"
              class="booking-input"
            />
          </div>

          <!-- DATE -->

          <div class="booking-field">
            <label
              for="booking-date"
              class="booking-label"
            >
              Tanggal Acara
            </label>

            <input
              id="booking-date"
              name="date"
              type="date"
              required
              class="booking-input booking-date"
            />
          </div>

          <!-- TIME -->

          <div class="booking-field">
            <label
              for="booking-time"
              class="booking-label"
            >
              Jam Acara
            </label>

            <input
              id="booking-time"
              name="time"
              type="time"
              required
              class="booking-input"
            />
          </div>

          <!-- EVENT TYPE -->

          <div class="booking-field" hidden data-schedule="akad">
            <label for="booking-akad" class="booking-label">Jam Acara Akad</label>
            <input id="booking-akad" name="akadTime" type="time" class="booking-input" disabled />
          </div>
          <div class="booking-field" hidden data-schedule="resepsi">
            <label for="booking-resepsi" class="booking-label">Jam Acara Resepsi</label>
            <input id="booking-resepsi" name="receptionTime" type="time" class="booking-input" disabled />
          </div>

          <div class="booking-field">
            <label
              for="booking-event"
              class="booking-label"
            >
              Jenis Acara
            </label>

            <select
              id="booking-event"
              name="event"
              required
              class="booking-input booking-select"
            >
              <option value="">
                Pilih jenis acara
              </option>

              {
                eventTypes.map((eventType) => (
                  <option value={eventType}>
                    {eventType}
                  </option>
                ))
              }
            </select>
          </div>

          <!-- GUEST -->

          <div class="booking-field">
            <label
              for="booking-guests"
              class="booking-label"
            >
              Jumlah Tamu
            </label>

            <input
              id="booking-guests"
              name="guests"
              type="number"
              min="1"
              inputmode="numeric"
              placeholder="Contoh: 500"
              class="booking-input"
            />
          </div>

          <!-- LOCATION -->

          <div
            class="booking-field md:col-span-2"
          >
            <label
              for="booking-location"
              class="booking-label"
            >
              Lokasi
            </label>

            <input
              id="booking-location"
              name="location"
              type="text"
              required
              autocomplete="street-address"
              placeholder="Venue / Kota / Lokasi acara"
              class="booking-input"
            />
          </div>

          <!-- MESSAGE -->

          <div
            class="booking-field md:col-span-2"
          >
            <label
              for="booking-message"
              class="booking-label"
            >
              Pesan / Detail Acara
            </label>

            <textarea
              id="booking-message"
              name="message"
              rows="5"
              placeholder="Ceritakan konsep acara, kebutuhan khusus, atau informasi lainnya..."
              class="booking-input booking-textarea"
            ></textarea>
          </div>

          <!-- =====================================
               ACTION
          ====================================== -->

          <div
            class="md:col-span-2 mt-2 border-t border-white/10 pt-8"
          >
            <div
              class="flex flex-col gap-4 md:flex-row md:items-center"
            >
              <!-- SUBMIT -->

              <button
                type="submit"
                class="group inline-flex min-h-[54px] items-center justify-center gap-5 bg-gold px-8 py-4 text-[10px] font-bold tracking-[0.2em] uppercase transition-all duration-300 hover:bg-gold-light"
              >
                <span
                  style="color: #11110f;"
                >
                  Send Booking Request
                </span>

                <span
                  style="color: #11110f;"
                  class="transition-transform duration-300 group-hover:translate-x-1"
                >
                  →
                </span>
              </button>

              <!-- DIRECT WHATSAPP -->

              <a
                id="booking-direct-whatsapp"
                href={directWhatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex min-h-[54px] items-center justify-center gap-5 border border-white/15 px-8 py-4 text-[10px] font-bold tracking-[0.2em] uppercase transition-all duration-300 hover:border-gold hover:bg-white/[0.03]"
              >
                <span
                  style="color: #f4f0e7;"
                  class="transition-colors duration-300 group-hover:text-[#b79b62]"
                >
                  Chat Via WhatsApp
                </span>

                <span
                  style="color: #f4f0e7;"
                  class="transition-all duration-300 group-hover:translate-x-1 group-hover:text-[#b79b62]"
                >
                  ↗
                </span>
              </a>
            </div>

            <p
              class="mt-5 max-w-xl text-[10px] leading-5 tracking-[0.08em] text-white/60"
            >
              Data dari form akan dirangkai menjadi
              pesan WhatsApp dan tidak disimpan di website.
            </p>

            <p id="booking-recipient" class="mt-3 text-xs leading-6 text-gold" aria-live="polite"></p>

            <!-- FORM STATUS -->

            <p
              id="booking-status"
              class="mt-4 hidden text-[10px] font-semibold tracking-[0.15em] text-gold uppercase"
              role="status"
              aria-live="polite"
            ></p>
          </div>
        </form>
      </div>
    </div>

    <!-- =====================================
         CLOSING STATEMENT
    ====================================== -->

    <div
      class="booking-reveal mt-20 border-t border-white/10 pt-12 md:mt-28 md:pt-16"
    >
      <div
        class="grid gap-8 lg:grid-cols-[0.55fr_1.45fr] lg:items-end"
      >
        <p
          class="text-[10px] font-bold tracking-[0.24em] text-gold uppercase"
        >
          Your Moment Starts Here
        </p>

        <p
          class="max-w-5xl font-serif text-[clamp(2.8rem,5vw,5.7rem)] leading-[0.9] tracking-[-0.03em]"
          style="word-spacing: 0.07em;"
        >
          Every great moment starts{" "}<span class="text-gold">with a conversation.</span>
        </p>
      </div>
    </div>

  </div>
</section>

<script>
  import { translate, currentLanguage } from '../i18n/client';
  function initializeBooking() {
    const section =
      document.querySelector<HTMLElement>(
        "#booking"
      );

    if (!section) {
      return;
    }

    if (
      section.dataset.initialized ===
      "true"
    ) {
      return;
    }

    section.dataset.initialized =
      "true";

    /* =====================================
       REVEAL
    ====================================== */

    const revealElements =
      section.querySelectorAll<HTMLElement>(
        ".booking-reveal"
      );

    if (
      "IntersectionObserver" in window
    ) {
      const observer =
        new IntersectionObserver(
          (entries) => {
            entries.forEach(
              (entry) => {
                if (
                  !entry.isIntersecting
                ) {
                  return;
                }

                if (
                  entry.target instanceof
                  HTMLElement
                ) {
                  entry.target.classList.add(
                    "is-visible"
                  );
                }

                observer.unobserve(
                  entry.target
                );
              }
            );
          },
          {
            threshold: 0.08,

            rootMargin:
              "0px 0px -40px 0px",
          }
        );

      revealElements.forEach(
        (element) => {
          observer.observe(
            element
          );
        }
      );
    } else {
      revealElements.forEach(
        (element) => {
          element.classList.add(
            "is-visible"
          );
        }
      );
    }

    /* =====================================
       DATE MINIMUM
    ====================================== */

    const dateInput =
      section.querySelector<HTMLInputElement>(
        "#booking-date"
      );

    if (dateInput) {
      const now = new Date();

      const localDate =
        new Date(
          now.getTime() -
            now.getTimezoneOffset() *
              60000
        )
          .toISOString()
          .slice(0, 10);

      dateInput.min = localDate;
    }

    /* =====================================
       FORM
    ====================================== */

    const form =
      section.querySelector<HTMLFormElement>(
        "#booking-form"
      );

    const status =
      section.querySelector<HTMLElement>(
        "#booking-status"
      );

    if (!form) {
      return;
    }

    const directChat = section.querySelector<HTMLAnchorElement>("#booking-direct-whatsapp");
    let pendingWhatsappUrl = "";
    function openWhatsappChooser(url: string) {
      if (!/Android/i.test(navigator.userAgent)) {
        window.open(url, "_blank", "noopener,noreferrer");
        return;
      }
      pendingWhatsappUrl = url;
      let dialog = document.querySelector<HTMLDialogElement>("#whatsapp-app-chooser");
      if (!dialog) {
        dialog = document.createElement("dialog");
        dialog.id = "whatsapp-app-chooser";
        dialog.setAttribute("aria-labelledby", "whatsapp-chooser-title");
        dialog.style.cssText = "width:min(92vw,420px);padding:0;border:1px solid #b79b62;border-radius:8px;background:#191916;color:#f4f0e7;box-shadow:0 24px 80px #0009";
        dialog.innerHTML = `<div style="padding:28px"><p style="margin:0 0 12px;color:#b79b62;font-size:10px;font-weight:700;letter-spacing:.2em">PILIH APLIKASI</p><h2 id="whatsapp-chooser-title" style="margin:0;font-family:var(--font-display,serif);font-size:30px;font-weight:400">Buka dengan WhatsApp</h2><p style="margin:12px 0 22px;color:#c7c3ba;font-size:14px;line-height:1.6">Pilih aplikasi untuk mengirim detail booking kamu.</p><div style="display:grid;gap:10px"><button type="button" data-whatsapp-app="regular" style="min-height:50px;padding:12px 16px;border:1px solid #ffffff30;background:#ffffff08;color:inherit;text-align:left;font:inherit;cursor:pointer">WhatsApp Messenger <span style="float:right;color:#b79b62">↗</span></button><button type="button" data-whatsapp-app="business" style="min-height:50px;padding:12px 16px;border:1px solid #ffffff30;background:#ffffff08;color:inherit;text-align:left;font:inherit;cursor:pointer">WhatsApp Business <span style="float:right;color:#b79b62">↗</span></button></div><button type="button" data-whatsapp-cancel style="margin-top:18px;padding:8px 0;border:0;background:none;color:#c7c3ba;font:inherit;cursor:pointer">Batal</button></div>`;
        document.body.append(dialog);
        dialog.addEventListener("click", (event) => {
          const target = event.target as HTMLElement;
          const choice = target.closest<HTMLButtonElement>("[data-whatsapp-app]");
          if (choice) {
            const destination = new URL(pendingWhatsappUrl);
            const phone = destination.pathname.slice(1);
            const params = new URLSearchParams(destination.search);
            const packageId = choice.dataset.whatsappApp === "business" ? "com.whatsapp.w4b" : "com.whatsapp";
            const intent = `intent://send?phone=${phone}&text=${encodeURIComponent(params.get("text") ?? "")}#Intent;scheme=whatsapp;package=${packageId};S.browser_fallback_url=${encodeURIComponent(pendingWhatsappUrl)};end`;
            dialog!.close();
            window.location.href = intent;
          } else if (target.closest("[data-whatsapp-cancel]") || target === dialog) {
            dialog!.close();
          }
        });
      }
      if (!dialog.open) dialog.showModal();
    }
    const eventSelect = section.querySelector<HTMLSelectElement>("#booking-event")!;
    const timeInput = section.querySelector<HTMLInputElement>("#booking-time")!;
    const akadInput = section.querySelector<HTMLInputElement>("#booking-akad")!;
    const receptionInput = section.querySelector<HTMLInputElement>("#booking-resepsi")!;
    const guestsInput = section.querySelector<HTMLInputElement>("#booking-guests")!;
    const locationInput = section.querySelector<HTMLInputElement>("#booking-location")!;
    const messageInput = section.querySelector<HTMLTextAreaElement>("#booking-message")!;
    const choices: Record<string, string[]> = {
      "Book Kang Denz": ["Lamaran", "Akad Only", "Akad & Resepsi", "Intimate Wedding"],
      "Nata Manten": ["Lamaran", "Akad Only", "Akad & Resepsi", "Intimate Wedding"],
      "Natsume Photo": ["Wedding", "Studio Photography"],
      "MC Class": ["Private Mentoring", "Private Intensive", "Small Class"],
    };
    let previousService = "";
    function setField(input: HTMLInputElement, visible: boolean, required = false) {
      input.closest<HTMLElement>(".booking-field")!.hidden = !visible;
      input.disabled = !visible;
      input.required = visible && required;
    }
    function labelFor(id: string, text: string) {
      section!.querySelector<HTMLLabelElement>(`label[for="${id}"]`)!.textContent = text;
    }
    function updateFields() {
      const service = String(new FormData(form!).get("service") ?? "");
      const photo = service === "Natsume Photo";
      const mentoring = service === "MC Class";
      const wedding = service === "Book Kang Denz" || service === "Nata Manten";
      if (previousService !== service || !eventSelect.dataset.ready) {
        eventSelect.replaceChildren(new Option(photo ? "Pilih jenis sesi" : mentoring ? "Pilih kelas" : "Pilih jenis acara", ""),
          ...(choices[service] ?? []).map((value) => new Option(value, value)));
        for (const input of [timeInput, akadInput, receptionInput, guestsInput]) input.value = "";
        previousService = service;
        eventSelect.dataset.ready = "true";
      }
      const akad = wedding && ["Akad Only", "Akad & Resepsi"].includes(eventSelect.value);
      const reception = wedding && eventSelect.value === "Akad & Resepsi";
      setField(timeInput, !akad, true);
      setField(akadInput, akad, true);
      setField(receptionInput, reception, true);
      setField(guestsInput, wedding || photo);
      setField(locationInput, wedding, true);
      labelFor("booking-event", photo ? "Jenis Sesi Foto" : mentoring ? "Pilihan Kelas" : "Jenis Acara");
      labelFor("booking-date", photo ? "Tanggal Sesi Foto" : mentoring ? "Tanggal Kelas yang Diinginkan" : "Tanggal Acara");
      labelFor("booking-time", photo ? "Jam Sesi Foto" : mentoring ? "Jam Kelas yang Diinginkan" : "Jam Acara");
      labelFor("booking-guests", photo ? "Jumlah Orang yang Difoto" : "Jumlah Tamu");
      guestsInput.placeholder = photo ? "Contoh: 2" : "Contoh: 500";
      labelFor("booking-location", "Lokasi Acara");
      locationInput.placeholder = "Venue / Kota / Lokasi acara";
      labelFor("booking-message", mentoring ? "Pengalaman & Target Belajar" : photo ? "Konsep / Detail Sesi Foto" : "Pesan / Detail Acara");
      messageInput.placeholder = mentoring ? "Ceritakan pengalaman dan kemampuan MC yang ingin dipelajari..." : photo ? "Ceritakan konsep foto dan kebutuhan sesi, misalnya family, graduation, atau maternity..." : "Ceritakan konsep acara dan kebutuhan khusus. Untuk intimate wedding, jelaskan rangkaian acara yang direncanakan...";
    }
    function buildWhatsappUrl() {
      const data = new FormData(form!);
      const service = String(data.get("service") ?? "");
      const phone = service === "Natsume Photo" ? "6282116428887" : "6281313216466";
      const lines = [translate("*BOOKING REQUEST*")];
      if (service) lines.push(`${translate("Penyedia")}: ${translate(service === "Book Kang Denz" ? "Kang Denz" : service)}`);
      const fieldIds = ["event", "name", "date", "time", "akad", "resepsi", "guests", "location", "message"];
      for (const id of fieldIds) {
        const input = section!.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`#booking-${id}`)!;
        if (input.disabled) continue;
        let value = String(data.get(input.name) ?? "").trim();
        if (!value) continue;
        const label = translate(id === "event" ? "Layanan" : section!.querySelector<HTMLLabelElement>(`label[for="${input.id}"]`)!.textContent!.trim());
        if (id === "event") value = translate(value);
        if (id === "date") {
          value = new Intl.DateTimeFormat(currentLanguage() === 'en' ? 'en-GB' : 'id-ID', { day: "numeric", month: "long", year: "numeric" }).format(new Date(`${value}T00:00:00`));
        }
        lines.push(`${label}: ${value}`);
      }
      return `https://wa.me/${phone}?text=${encodeURIComponent(lines.join("\n"))}`;
    }
    function updateDirectChat() {
      if (directChat) directChat.href = buildWhatsappUrl();
      const recipient = section!.querySelector<HTMLElement>("#booking-recipient");
      const service = new FormData(form!).get("service");
      if (recipient) {
        recipient.textContent = !service ? "" : service === "Natsume Photo"
          ? "Booking dikirim ke WhatsApp Admin Natsume: +62 821-1642-8887."
          : "Booking dikirim ke WhatsApp Kang Denz: +62 813-1321-6466.";
      }
    }
    form.addEventListener("input", updateDirectChat);
    document.addEventListener('site:language-change', updateDirectChat);
    section.addEventListener("change", () => { updateFields(); updateDirectChat(); });
    updateFields();
    updateDirectChat();

    directChat?.addEventListener("click", (event) => {
      event.preventDefault();
      openWhatsappChooser(buildWhatsappUrl());
    });

    form.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();

        if (!form.reportValidity()) {
          return;
        }

        const data =
          new FormData(form);

        const service =
          String(
            data.get("service") ?? ""
          );

        if (!service) {
          status?.classList.remove(
            "hidden"
          );

          if (status) {
            status.textContent =
              "Silakan pilih layanan terlebih dahulu.";
          }

          return;
        }

        const whatsappUrl = buildWhatsappUrl();

        if (status) {
          status.textContent =
            /Android/i.test(navigator.userAgent) ? "Pilih aplikasi WhatsApp yang ingin digunakan." : "Membuka WhatsApp...";

          status.classList.remove(
            "hidden"
          );
        }

        openWhatsappChooser(whatsappUrl);
      }
    );
  }

  initializeBooking();

  document.addEventListener(
    "astro:page-load",
    initializeBooking
  );
</script>
