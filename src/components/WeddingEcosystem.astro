---
const ecosystem = [
  {
    number: "01",
    brand: "Kang Denz",
    role: "Professional Wedding MC",
    phrase: "Creating Moments.",
    description:
      "Membawa alur, suasana, dan interaksi agar setiap bagian wedding terasa hidup tanpa mengambil pusat perhatian dari pasangan.",
    href: "#wedding-mc",
  },
  {
    number: "02",
    brand: "Nata Manten",
    role: "Wedding Planner & Coordination",
    phrase: "Coordinating Stories.",
    description:
      "Membantu pasangan merencanakan, mengatur, dan mengkoordinasikan berbagai kebutuhan wedding secara lebih terarah.",
    href: "#nata-manten",
  },
  {
    number: "03",
    brand: "Natsume Photo",
    role: "Photography & Studio",
    phrase: "Capturing Memories.",
    description:
      "Mengabadikan momen melalui photography dan dokumentasi yang menjadi bagian dari cerita sebuah wedding.",
    href: "#natsume",
  },
];
---

<section
  id="ecosystem"
  class="relative overflow-hidden bg-charcoal text-ivory"
>
  <!-- DECORATIVE BACKGROUND -->

  <div
    class="pointer-events-none absolute top-0 right-0 h-[700px] w-[700px] translate-x-1/3 -translate-y-1/3 rounded-full bg-gold/[0.04] blur-[170px]"
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute bottom-0 left-0 h-[500px] w-[500px] -translate-x-1/3 translate-y-1/3 rounded-full bg-gold/[0.025] blur-[150px]"
    aria-hidden="true"
  ></div>

  <div
    class="container-luxury py-20 md:py-28 lg:py-32"
  >
    <!-- =====================================
         HEADER
    ====================================== -->

    <div
      class="ecosystem-reveal border-b border-white/10 pb-14 md:pb-20"
    >
      <div class="flex items-center gap-4">
        <span
          class="h-px w-10 bg-gold"
        ></span>

        <p class="gold-label">
          The Wedding Ecosystem
        </p>
      </div>

      <div
        class="mt-8 grid gap-8 lg:grid-cols-[1.25fr_0.75fr] lg:items-end lg:gap-16"
      >
        <div>
          <h2
            class="max-w-5xl font-serif text-[clamp(3.5rem,7vw,7.5rem)] leading-[0.85] tracking-[-0.05em]"
          >
            More than

            <span class="text-gold">
              one role.
            </span>

            <span class="block">
              One complete understanding of wedding.
            </span>
          </h2>
        </div>

        <div>
          <p
            class="max-w-md text-sm leading-7 text-white/45 md:text-base md:leading-8"
          >
            Pengalaman Kang Denz berkembang dari atas panggung
            menuju perencanaan dan dokumentasi, membentuk
            pemahaman wedding dari berbagai sisi yang saling
            terhubung.
          </p>
        </div>
      </div>
    </div>

    <!-- =====================================
         MAIN BRAND STATEMENT
    ====================================== -->

    <div
      class="ecosystem-reveal py-16 md:py-24"
    >
      <div
        class="max-w-6xl"
      >
        <p
          class="ecosystem-statement font-serif text-[clamp(3rem,7vw,8rem)] leading-[0.82] tracking-[-0.05em]"
        >
          <span class="block">
            Creating
            <span class="text-gold">
              Moments.
            </span>
          </span>

          <span
            class="block text-white/55"
          >
            Coordinating
            <span class="text-gold">
              Stories.
            </span>
          </span>

          <span
            class="block text-white/25"
          >
            Capturing
            <span class="text-gold">
              Memories.
            </span>
          </span>
        </p>
      </div>
    </div>

    <!-- =====================================
         ECOSYSTEM ITEMS
    ====================================== -->

    <div
      class="border-t border-white/10"
    >
      {
        ecosystem.map((item) => (
          <a
            href={item.href}
            class="ecosystem-item ecosystem-reveal group relative grid gap-5 border-b border-white/10 py-8 md:grid-cols-[80px_0.85fr_1.15fr] md:items-center md:gap-8 md:py-11"
          >
            <!-- NUMBER -->

            <p
              class="text-[8px] font-semibold tracking-[0.22em] text-white/25 transition-colors duration-300 group-hover:text-gold"
            >
              {item.number}
            </p>

            <!-- BRAND -->

            <div>
              <p
                class="text-[8px] font-semibold tracking-[0.22em] text-gold uppercase"
              >
                {item.role}
              </p>

              <h3
                class="mt-3 font-serif text-[clamp(2.7rem,4vw,4.8rem)] leading-[0.9] tracking-[-0.035em] transition-colors duration-300 group-hover:text-gold"
              >
                {item.brand}
              </h3>
            </div>

            <!-- CONTENT -->

            <div
              class="md:flex md:items-center md:justify-between md:gap-10"
            >
              <div>
                <p
                  class="font-serif text-2xl text-ivory-muted md:text-3xl"
                >
                  {item.phrase}
                </p>

                <p
                  class="mt-4 max-w-xl text-sm leading-7 text-white/40 md:text-base"
                >
                  {item.description}
                </p>
              </div>

              <span
                class="mt-5 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/15 text-sm text-white/40 transition-all duration-300 group-hover:border-gold group-hover:bg-gold group-hover:text-charcoal md:mt-0"
                aria-hidden="true"
              >
                ↘
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <!-- =====================================
         CLOSING
    ====================================== -->

    <div
      class="ecosystem-reveal mt-16 grid gap-8 border-t border-white/10 pt-12 md:mt-20 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20"
    >
      <div>
        <p
          class="text-[8px] font-semibold tracking-[0.25em] text-gold uppercase"
        >
          One Perspective
        </p>
      </div>

      <div>
        <p
          class="max-w-4xl font-serif text-[clamp(2.3rem,4vw,4.5rem)] leading-[1.02] tracking-[-0.03em] text-ivory-muted"
        >
          Understanding a wedding from

          <span class="text-gold">
            before the event,
          </span>

          during the moment, and

          <span class="text-gold">
            after it becomes a memory.
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  function initializeEcosystemReveal() {
    const elements =
      document.querySelectorAll<HTMLElement>(
        ".ecosystem-reveal"
      );

    if (
      !(
        "IntersectionObserver" in
        window
      )
    ) {
      elements.forEach((element) => {
        element.classList.add(
          "is-visible"
        );
      });

      return;
    }

    const observer =
      new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }

            if (
              entry.target instanceof HTMLElement
            ) {
              entry.target.classList.add(
                "is-visible"
              );
            }

            observer.unobserve(
              entry.target
            );
          });
        },
        {
          threshold: 0.08,

          rootMargin:
            "0px 0px -40px 0px",
        }
      );

    elements.forEach((element) => {
      observer.observe(element);
    });
  }

  initializeEcosystemReveal();

  document.addEventListener(
    "astro:page-load",
    initializeEcosystemReveal
  );
</script>