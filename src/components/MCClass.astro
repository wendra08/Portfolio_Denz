  },
  {
    number: "03",
    title: "Vocal Delivery",
  },
  {
    number: "04",
    title: "Opening & Closing",
  },
  {
    number: "05",
    title: "Bridging & Improvisation",
  },
  {
    number: "06",
    title: "Guest Engagement",
  },
  {
    number: "07",
    title: "Wedding & Lamaran MC",
