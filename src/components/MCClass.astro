---
import Photo from "./Photo.astro";
const programs = [
  {
    title: "Private Mentoring",
    format: "Privat 1-on-1",
    description: "Sesi privat yang fokus pada kebutuhan dan perkembangan kamu, dengan materi yang menyesuaikan kemampuan serta tujuan belajar.",
    features: ["Total 2 jam: 1 jam per hari selama 2 hari, atau selesai dalam 1 hari.", "1 peserta", "Offline / online, menyesuaikan", "Materi menyesuaikan kebutuhan", "Praktik & simulasi langsung"],
    featured: false,
  },
  {
    title: "Private Intensive",
    format: "Privat 1-on-1",
    description: "Pendampingan lebih mendalam untuk kamu yang serius ingin menjadi MC, melalui materi lengkap, studi kasus nyata, dan evaluasi penampilan.",
    features: ["Total 4 jam: 2 jam per hari selama 2 hari.", "1 peserta", "Offline / online, menyesuaikan", "Materi lengkap & studi kasus nyata", "Simulasi full wedding + evaluasi video"],
    featured: true,
  },
  {
    title: "Small Class",
    format: "Maksimal 5 peserta",
    description: "Belajar bersama dalam grup kecil dengan suasana yang interaktif dan banyak praktik. Setiap peserta mendapat kesempatan tampil dan masukan langsung.",
    features: ["Durasi 4 jam", "Maksimal 5 peserta", "Offline / online, menyesuaikan", "Materi terstruktur", "Setiap peserta tampil dan dikoreksi langsung"],
    featured: false,
  },
];
const materials = [
  {
    number: "01",
    title: "Basic Public Speaking",
    description: "Mempelajari dasar berbicara di depan audiens, menyusun pesan yang jelas, mengelola rasa gugup, dan membangun kepercayaan diri saat tampil.",
  },
  {
    number: "02",
    title: "Artikulasi & Intonasi",
    description: "Melatih kejelasan pengucapan dan variasi nada agar setiap kalimat mudah dipahami serta sesuai dengan makna dan suasana acara.",
  },
  {
    number: "03",
    title: "Vocal Delivery",
    description: "Melatih pengaturan napas, volume, tempo, dan jeda untuk membawakan acara dengan suara yang nyaman didengar dan terkontrol.",
  },
  {
    number: "04",
    title: "Opening & Closing",
    description: "Belajar menyusun pembukaan yang membangun suasana dan penutupan yang berkesan, dengan pilihan kata yang sesuai karakter acara.",
  },
  {
    number: "05",
    title: "Bridging & Improvisation",
    description: "Berlatih menghubungkan satu rangkaian acara ke rangkaian berikutnya serta merespons situasi secara spontan tanpa kehilangan arah pembicaraan.",
  },
  {
    number: "06",
    title: "Guest Engagement",
    description: "Mempelajari cara membaca respons audiens dan membangun interaksi yang hangat, sopan, serta nyaman bagi tamu dari berbagai latar belakang.",
  },
  {
    number: "07",
    title: "Wedding & Lamaran MC",
    description: "Mengenali alur lamaran dan pernikahan, pemilihan bahasa, serta cara berkomunikasi dengan pasangan, keluarga, dan tim acara.",
  },
  {
    number: "08",
    title: "Handling Unexpected Situations",
    description: "Berlatih menghadapi perubahan rundown, keterlambatan, atau kendala teknis dengan tenang sambil menjaga komunikasi dan suasana acara.",
  },
  {
    number: "09",
    title: "Practice & Evaluation",
    description: "Mempraktikkan pembawaan acara melalui simulasi, lalu mengevaluasi penyampaian dan menerima masukan untuk mengetahui bagian yang perlu dikembangkan.",
  },
];
---

<section
  id="mc-class"
  class="relative overflow-hidden bg-ivory text-charcoal"
>
  <!-- DECORATIVE -->

  <div
    class="pointer-events-none absolute top-0 right-0 hidden font-serif text-[20rem] leading-none text-charcoal/[0.02] lg:block"
    aria-hidden="true"
  >
    MC
  </div>

  <div
    class="container-luxury py-20 md:py-28 lg:py-32"
  >
    <!-- =====================================
         HEADER
    ====================================== -->

    <div
      class="mcclass-reveal border-b border-charcoal/10 pb-14 md:pb-20"
    >
      <div
        class="flex items-center gap-4"
      >
        <span class="h-px w-10 bg-gold"></span>

        <p class="gold-label">
          Kang Denz MC Class
        </p>
      </div>

      <div
        class="mt-8 grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end lg:gap-20"
      >
        <div>
          <p
            class="text-[10px] font-semibold tracking-[0.22em] text-charcoal/70 uppercase"
          >
            Private Mentoring & Small Class
          </p>

          <h2
            class="mt-5 max-w-5xl font-serif text-[clamp(2.75rem,7vw,7.5rem)] leading-[0.84] tracking-[-0.05em]"
          >
            Learn. <span class="text-gold">
              Practice.
            </span>{" "}
            <span class="block">
              Perform.
            </span>
          </h2>
        </div>

        <div>
          <p
            class="max-w-md text-sm leading-7 text-charcoal/60 md:text-base md:leading-8"
          >
            Pilih pendampingan privat atau kelas kecil untuk belajar menjadi MC secara personal, praktis, dan terarah bersama Kang Denz.
          </p>

          <div
            class="mt-8 border-t border-charcoal/10 pt-6"
          >
            <p
              class="text-[10px] font-semibold tracking-[0.22em] text-gold uppercase"
            >
              Mentor
            </p>

            <p
              class="mt-2 font-serif text-3xl"
            >
              Kang Denz
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- =====================================
         MAIN VISUAL
    ====================================== -->

    <div
      class="mcclass-reveal mt-14 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16"
    >
      <!-- IMAGE -->

      <div
        class="group relative overflow-hidden bg-charcoal"
      >
        <div
          class="relative aspect-[4/5] overflow-hidden"
        >
          <Photo
            src="/images/mc-class/mc-class-main.jpeg"
            alt="Kang Denz Private MC Mentoring"
            class="mcclass-main-image h-full w-full object-cover"
            loading="lazy"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-black/10"
            aria-hidden="true"
          ></div>

          <div
            class="absolute right-5 bottom-5 left-5 border-t border-white/20 pt-4"
          >
            <p
              class="text-[10px] font-semibold tracking-[0.22em] text-gold uppercase"
            >
              Real Experience
            </p>

            <p
              class="mt-2 font-serif text-2xl text-white md:text-3xl"
            >
              Learn from the field.
            </p>
          </div>
        </div>
      </div>

      <!-- CONTENT -->

      <div>
        <p
          class="text-[10px] font-semibold tracking-[0.25em] text-gold uppercase"
        >
          Learn From Real Experience
        </p>

        <h3
          class="mt-5 max-w-xl font-serif text-[clamp(2.8rem,5vw,5rem)] leading-[0.92] tracking-[-0.04em]"
        >
          Not only theory. <span class="block text-gold">
            Real situations.
          </span>{" "}
          Real practice.
        </h3>

        <p
          class="mt-7 max-w-xl text-sm leading-8 text-charcoal/60 md:text-base"
        >
          Pembelajaran tidak hanya berdasarkan teori,
          tetapi juga pengalaman nyata di lapangan sebagai MC.
          Fokus mentoring diarahkan pada cara membaca situasi,
          membangun alur, berkomunikasi dengan audiens,
          dan menangani kondisi yang tidak selalu berjalan
          sesuai rencana.
        </p>

        <div
          class="mt-8 grid grid-cols-2 gap-6 border-t border-charcoal/10 pt-6"
        >
          <div>
            <p
              class="text-[10px] font-semibold tracking-[0.2em] text-charcoal/70 uppercase"
            >
              Format
            </p>

            <p
              class="mt-2 font-serif text-2xl"
            >
              Privat & Kelas Kecil
            </p>
          </div>

          <div>
            <p
              class="text-[10px] font-semibold tracking-[0.2em] text-charcoal/70 uppercase"
            >
              Approach
            </p>

            <p
              class="mt-2 font-serif text-2xl"
            >
              Practical
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="mcclass-reveal mt-20 border-t border-charcoal/10 pt-12 md:mt-28 md:pt-16" aria-labelledby="mc-programs-title">
      <p class="gold-label">Pilihan Program</p>
      <h3 id="mc-programs-title" class="mt-5 max-w-3xl font-serif text-[clamp(2.5rem,5vw,4.5rem)] leading-tight tracking-[-0.035em]">Temukan cara belajar yang sesuai untukmu.</h3>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {programs.map((program) => (
          <article class:list={["relative flex flex-col rounded-xl border p-7 md:p-8", program.featured ? "border-gold bg-white/60" : "border-charcoal/15 bg-white/25"]}>
            {program.featured && <p class="absolute -top-4 left-7 rounded-full bg-charcoal px-4 py-2 text-[10px] font-semibold tracking-widest text-ivory uppercase">Paling Diminati</p>}
            <p class="mt-3 text-xs font-semibold tracking-widest text-gold uppercase">{program.format}</p>
            <h4 class="mt-4 font-serif text-4xl leading-tight">{program.title}</h4>
            <p class="mt-4 text-sm leading-7 text-charcoal/70">{program.description}</p>
            <ul class="mt-7 space-y-4 border-t border-charcoal/10 pt-6 text-sm leading-6 text-charcoal/80">
              {program.features.map((feature) => <li class="flex items-start gap-3"><span class="text-gold" aria-hidden="true">✓</span><span>{feature}</span></li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>

    <!-- =====================================
         MATERIALS
    ====================================== -->

    <div
      class="mcclass-reveal mt-20 border-t border-charcoal/10 pt-14 md:mt-28 md:pt-20"
    >
      <div
        class="grid gap-8 lg:grid-cols-[0.55fr_1.45fr] lg:items-end"
      >
        <div>
          <p
            class="text-[10px] font-semibold tracking-[0.25em] text-gold uppercase"
          >
            What You'll Learn
          </p>
        </div>

        <div>
          <h3
            class="max-w-4xl font-serif text-[clamp(3rem,5.5vw,6rem)] leading-[0.9] tracking-[-0.04em]"
          >
            Build the skill. <span class="text-gold">
              Build the confidence.
            </span>
          </h3>
        </div>
      </div>
    </div>

    <!-- MATERIAL LIST -->

    <div
      class="mt-10 grid md:grid-cols-2"
    >
      {
        materials.map((item, index) => (
          <details
            class:list={[
              "mcclass-item mcclass-reveal group relative border-b border-charcoal/10 py-7 md:py-9",
              index % 2 === 0
                ? "md:border-r md:pr-10 lg:pr-14"
                : "md:pl-10 lg:pl-14"
            ]}
          >
            <summary
              class="service-toggle flex cursor-pointer items-center justify-between gap-6"
            >
              <div
                class="flex items-center gap-5"
              >
                <p
                  class="text-[10px] font-semibold tracking-[0.2em] text-gold"
                >
                  {item.number}
                </p>

                <h4
                  class="font-serif text-2xl tracking-[-0.025em] transition-colors duration-300 group-hover:text-gold md:text-3xl lg:text-4xl"
                >
                  {item.title}
                </h4>
              </div>

              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-charcoal/10 text-xs text-charcoal/70 transition-all duration-300 group-hover:border-gold group-hover:bg-gold group-hover:text-ivory"
                aria-hidden="true"
              >
                <span class="expand-icon" aria-hidden="true">+</span>
                <span class="collapse-icon" aria-hidden="true">&minus;</span>
              </span>
            </summary>
            <p class="mt-5 max-w-xl text-sm leading-7 text-charcoal/70 md:text-base md:leading-8">{item.description}</p>
          </details>
        ))
      }
    </div>

    <div class="mcclass-reveal mt-20 border-t border-charcoal/10 pt-12 md:mt-28 md:pt-16" aria-labelledby="mc-certificate-title">
      <p class="gold-label">Sertifikat Penyelesaian Kelas</p>
      <h3 id="mc-certificate-title" class="mt-5 max-w-3xl font-serif text-[clamp(2.5rem,5vw,4.5rem)] leading-tight tracking-[-0.035em]">Sebuah penanda perjalanan belajarmu.</h3>
      <p class="mt-5 max-w-2xl text-sm leading-7 text-charcoal/70 md:text-base">Berikut contoh sertifikat penyelesaian program Private MC Mentoring bersama Kang Denz.</p>
      <figure class="mt-8">
        <a href="/images/mc-class/certificate-completion.jpeg" target="_blank" rel="noopener noreferrer" class="block rounded-lg border border-gold/40 bg-white p-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold md:p-4" aria-label="Lihat contoh sertifikat ukuran penuh (tab baru)">
          <img src="/images/mc-class/certificate-completion.jpeg" alt="Contoh sertifikat penyelesaian Private MC Mentoring Kang Denz" width="1491" height="1055" loading="lazy" decoding="async" class="h-auto w-full" />
        </a>
        <figcaption class="mt-4 text-xs leading-6 text-charcoal/60">Contoh sertifikat peserta. Klik gambar untuk melihat ukuran penuh.</figcaption>
      </figure>
    </div>

    <!-- =====================================
         CLOSING CTA
    ====================================== -->

    <div
      class="mcclass-reveal mt-20 grid gap-10 border-t border-charcoal/10 pt-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-20"
    >
      <div>
        <p
          class="text-[10px] font-semibold tracking-[0.25em] text-gold uppercase"
        >
          Ready To Learn?
        </p>

        <p
          class="mt-5 max-w-4xl font-serif text-[clamp(2.8rem,5vw,5.5rem)] leading-[0.95] tracking-[-0.04em]"
        >
          Start with practice. <span class="text-gold">
            Grow with experience.
          </span>
        </p>
      </div>

      <div>
        <p
          class="max-w-md text-sm leading-7 text-charcoal/70 md:text-base"
        >
          Mentoring dibuat personal agar pembelajaran
          dapat disesuaikan dengan kebutuhan,
          pengalaman, dan target masing-masing peserta.
        </p>


      </div>
    </div>

  </div>
</section>

<style>
  .service-toggle { list-style: none; }
  .service-toggle::-webkit-details-marker { display: none; }
  .service-toggle:focus-visible { outline: 2px solid #b79b62; outline-offset: 6px; }
  .collapse-icon { display: none; }
  details[open] .expand-icon { display: none; }
  details[open] .collapse-icon { display: inline; }
</style>

<script>
  function initializeMCClass() {
    const elements =
      document.querySelectorAll<HTMLElement>(
        ".mcclass-reveal"
      );

    if (
      !(
        "IntersectionObserver" in
        window
      )
    ) {
      elements.forEach((element) => {
        element.classList.add(
          "is-visible"
        );
      });

      return;
    }

    const observer =
      new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }

            if (
              entry.target instanceof HTMLElement
            ) {
              entry.target.classList.add(
                "is-visible"
              );
            }

            observer.unobserve(
              entry.target
            );
          });
        },
        {
          threshold: 0.08,
          rootMargin:
            "0px 0px -40px 0px",
        }
      );

    elements.forEach((element) => {
      observer.observe(element);
    });
  }

  initializeMCClass();

  document.addEventListener(
    "astro:page-load",
    initializeMCClass
  );
</script>
