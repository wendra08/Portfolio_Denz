---

<section
  id="mc-class"
  class="relative overflow-hidden bg-ivory text-charcoal"
>
  <!-- DECORATIVE -->

  <div
    class="pointer-events-none absolute top-0 right-0 hidden font-serif text-[20rem] leading-none text-charcoal/[0.02] lg:block"
    aria-hidden="true"
  >
    MC
  </div>

  <div
    class="container-luxury py-20 md:py-28 lg:py-32"
  >
    <!-- =====================================
         HEADER
    ====================================== -->

    <div
      class="mcclass-reveal border-b border-charcoal/10 pb-14 md:pb-20"
    >
      <div
        class="flex items-center gap-4"
      >
        <span class="h-px w-10 bg-gold"></span>

        <p class="gold-label">
          Kang Denz MC Class
        </p>
      </div>

      <div
        class="mt-8 grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end lg:gap-20"
      >
        <div>
          <p
            class="text-[9px] font-semibold tracking-[0.22em] text-charcoal/35 uppercase"
          >
            Private 1-on-1 Mentoring
          </p>

          <h2
            class="mt-5 max-w-5xl font-serif text-[clamp(3.8rem,7vw,7.5rem)] leading-[0.84] tracking-[-0.05em]"
          >
            Learn. <span class="text-gold">
              Practice.
            </span>

            <span class="block">
              Perform.
            </span>
          </h2>
        </div>

        <div>
          <p
            class="max-w-md text-sm leading-7 text-charcoal/60 md:text-base md:leading-8"
          >
            Private MC Mentoring untuk kamu yang ingin belajar
            menjadi MC secara lebih personal, praktis,
            dan terarah.
          </p>

          <div
            class="mt-8 border-t border-charcoal/10 pt-6"
          >
            <p
              class="text-[8px] font-semibold tracking-[0.22em] text-gold uppercase"
            >
              Mentor
            </p>

            <p
              class="mt-2 font-serif text-3xl"
            >
              Kang Denz
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- =====================================
         MAIN VISUAL
    ====================================== -->

    <div
      class="mcclass-reveal mt-14 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16"
    >
      <!-- IMAGE -->

      <div
        class="group relative overflow-hidden bg-charcoal"
      >
        <div
          class="relative aspect-[4/5] overflow-hidden"
        >
          <img
            src="/images/mc-class/mc-class-main.jpeg"
            alt="Kang Denz Private MC Mentoring"
            class="mcclass-main-image h-full w-full object-cover"
            loading="lazy"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-black/10"
            aria-hidden="true"
          ></div>

          <div
            class="absolute right-5 bottom-5 left-5 border-t border-white/20 pt-4"
          >
            <p
              class="text-[7px] font-semibold tracking-[0.22em] text-gold uppercase"
            >
              Real Experience
            </p>

            <p
              class="mt-2 font-serif text-2xl text-white md:text-3xl"
            >
              Learn from the field.
            </p>
          </div>
        </div>
      </div>

      <!-- CONTENT -->

      <div>
        <p
          class="text-[8px] font-semibold tracking-[0.25em] text-gold uppercase"
        >
          Learn From Real Experience
        </p>

        <h3
          class="mt-5 max-w-xl font-serif text-[clamp(2.8rem,5vw,5rem)] leading-[0.92] tracking-[-0.04em]"
        >
          Not only theory. <span class="block text-gold">
            Real situations.
          </span>

          Real practice.
        </h3>

        <p
          class="mt-7 max-w-xl text-sm leading-8 text-charcoal/60 md:text-base"
        >
          Pembelajaran tidak hanya berdasarkan teori,
          tetapi juga pengalaman nyata di lapangan sebagai MC.
          Fokus mentoring diarahkan pada cara membaca situasi,
          membangun alur, berkomunikasi dengan audiens,
          dan menangani kondisi yang tidak selalu berjalan
          sesuai rencana.
        </p>

        <div
          class="mt-8 grid grid-cols-2 gap-6 border-t border-charcoal/10 pt-6"
        >
          <div>
            <p
              class="text-[7px] font-semibold tracking-[0.2em] text-charcoal/35 uppercase"
            >
              Format
            </p>

            <p
              class="mt-2 font-serif text-2xl"
            >
              Private 1-on-1
            </p>
          </div>

          <div>
            <p
              class="text-[7px] font-semibold tracking-[0.2em] text-charcoal/35 uppercase"
            >
              Approach
            </p>

            <p
              class="mt-2 font-serif text-2xl"
            >
              Practical
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- =====================================
         MATERIALS
    ====================================== -->

    <div
      class="mcclass-reveal mt-20 border-t border-charcoal/10 pt-14 md:mt-28 md:pt-20"
    >
      <div
        class="grid gap-8 lg:grid-cols-[0.55fr_1.45fr] lg:items-end"
      >
        <div>
          <p
            class="text-[8px] font-semibold tracking-[0.25em] text-gold uppercase"
          >
            What You'll Learn
          </p>
        </div>

        <div>
          <h3
            class="max-w-4xl font-serif text-[clamp(3rem,5.5vw,6rem)] leading-[0.9] tracking-[-0.04em]"
          >
            Build the skill. <span class="text-gold">
              Build the confidence.
            </span>
          </h3>
        </div>
      </div>
    </div>

    <!-- MATERIAL LIST -->

    <div
      class="mt-10 grid md:grid-cols-2"
    >
      {
        materials.map((item, index) => (
          <article
            class:list={[
              "mcclass-item mcclass-reveal group relative border-b border-charcoal/10 py-7 md:py-9",
              index % 2 === 0
                ? "md:border-r md:pr-10 lg:pr-14"
                : "md:pl-10 lg:pl-14"
            ]}
          >
            <div
              class="flex items-center justify-between gap-6"
            >
              <div
                class="flex items-center gap-5"
              >
                <p
                  class="text-[8px] font-semibold tracking-[0.2em] text-gold"
                >
                  {item.number}
                </p>

                <h4
                  class="font-serif text-2xl tracking-[-0.025em] transition-colors duration-300 group-hover:text-gold md:text-3xl lg:text-4xl"
                >
                  {item.title}
                </h4>
              </div>

              <span
                class="hidden h-9 w-9 shrink-0 items-center justify-center rounded-full border border-charcoal/10 text-xs text-charcoal/30 transition-all duration-300 group-hover:border-gold group-hover:bg-gold group-hover:text-ivory sm:flex"
                aria-hidden="true"
              >
                +
              </span>
            </div>
          </article>
        ))
      }
    </div>

    <!-- =====================================
         CLOSING CTA
    ====================================== -->

    <div
      class="mcclass-reveal mt-20 grid gap-10 border-t border-charcoal/10 pt-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-20"
    >
      <div>
        <p
          class="text-[8px] font-semibold tracking-[0.25em] text-gold uppercase"
        >
          Ready To Learn?
        </p>

        <p
          class="mt-5 max-w-4xl font-serif text-[clamp(2.8rem,5vw,5.5rem)] leading-[0.95] tracking-[-0.04em]"
        >
          Start with practice. <span class="text-gold">
            Grow with experience.
          </span>
        </p>
      </div>

      <div>
        <p
          class="max-w-md text-sm leading-7 text-charcoal/55 md:text-base"
        >
          Mentoring dibuat personal agar pembelajaran
          dapat disesuaikan dengan kebutuhan,
          pengalaman, dan target masing-masing peserta.
        </p>

        <a
          href="#booking"
          class="group mt-8 inline-flex items-center justify-center gap-4 bg-[#11110f] px-8 py-4 text-[9px] font-bold tracking-[0.2em] uppercase transition-all duration-300 hover:bg-[#b79b62]"
        >
          <span
            style="color: #f4f0e7;"
            class="transition-colors duration-300 group-hover:text-[#11110f]"
          >
            Join Private Class
          </span>

          <span
            style="color: #f4f0e7;"
            class="transition-all duration-300 group-hover:translate-x-1 group-hover:text-[#11110f]"
          >
            →
          </span>
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  function initializeMCClass() {
    const elements =
      document.querySelectorAll<HTMLElement>(
        ".mcclass-reveal"
      );

    if (
      !(
        "IntersectionObserver" in
        window
      )
    ) {
      elements.forEach((element) => {
        element.classList.add(
          "is-visible"
        );
      });

      return;
    }

    const observer =
      new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }

            if (
              entry.target instanceof HTMLElement
            ) {
              entry.target.classList.add(
                "is-visible"
              );
            }

            observer.unobserve(
              entry.target
            );
          });
        },
        {
          threshold: 0.08,
          rootMargin:
            "0px 0px -40px 0px",
        }
      );

    elements.forEach((element) => {
      observer.observe(element);
    });
  }

  initializeMCClass();

  document.addEventListener(
    "astro:page-load",
    initializeMCClass
  );
</script>