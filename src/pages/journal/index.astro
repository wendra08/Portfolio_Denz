---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";

import { getCollection } from "astro:content";

const allPosts =
  await getCollection("journal");

const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      b.data.publishedAt.getTime() -
      a.data.publishedAt.getTime()
  );

const categories = [
  "All",
  "Wedding Stories",
  "Behind The Scene",
  "MC Journal",
  "Wedding Tips",
  "MC Class",
];

const formatter =
  new Intl.DateTimeFormat("id-ID", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
---

<BaseLayout
  title="Journal — Kang Denz"
  description="Wedding stories, behind the scenes, MC journal, wedding tips, dan MC Class dari Kang Denz."
>
  <Navbar />

  <main
    class="min-h-screen bg-ivory text-charcoal"
  >
    <!-- HERO -->

    <section
      class="border-b border-charcoal/10 pt-36 pb-16 md:pt-44 md:pb-24"
    >
      <div class="container-luxury">
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <span
              class="h-px w-10 bg-gold"
            ></span>

            <p class="gold-label">
              Journal
            </p>
          </div>

          <a
            href="/"
            class="inline-flex items-center gap-2 text-[8px] font-bold tracking-[0.18em] text-charcoal/60 uppercase transition-colors duration-300 hover:text-gold"
          >
            <span aria-hidden="true">←</span>
            Back To Home
          </a>
        </div>

        <h1
          class="mt-8 max-w-6xl font-serif text-[clamp(4rem,9vw,9rem)] leading-[0.82] tracking-[-0.055em]"
        >
          Stories worth&nbsp;<span class="text-gold">sharing.</span>
        </h1>

        <p
          class="mt-9 max-w-xl text-sm leading-7 text-charcoal/55 md:text-base md:leading-8"
        >
          Cerita dari wedding, pengalaman
          sebagai MC, behind the scenes,
          wedding tips, dan pembelajaran dari
          perjalanan di dunia event.
        </p>
      </div>
    </section>

    <!-- FILTER -->

    <section>
      <div
        class="container-luxury py-12 md:py-16"
      >
        <div
          class="journal-category-scroll flex gap-3 overflow-x-auto pb-3"
        >
          {
            categories.map(
              (category, index) => (
                <button
                  type="button"
                  class="journal-category shrink-0 rounded-full border border-charcoal/15 px-5 py-3 text-[8px] font-bold tracking-[0.17em] uppercase transition-all duration-300"
                  data-category={category}
                  data-active={
                    index === 0
                      ? "true"
                      : "false"
                  }
                >
                  {category}
                </button>
              )
            )
          }
        </div>

        <!-- GRID -->

        <div
          id="journal-page-grid"
          class="mt-10 grid gap-x-7 gap-y-14 md:grid-cols-2 lg:grid-cols-3"
        >
          {
            posts.map((post) => (
              <article
                class="journal-page-card group"
                data-post-category={
                  post.data.category
                }
              >
                <a
                  href={`/journal/${post.id}`}
                >
                  <div
                    class="relative aspect-[4/5] overflow-hidden bg-charcoal"
                  >
                    <img
                      src={post.data.cover}
                      alt={post.data.title}
                      class="journal-image h-full w-full object-cover"
                      loading="lazy"
                    />

                    <div
                      class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"
                    ></div>

                    <p
                      class="absolute bottom-5 left-5 text-[7px] font-bold tracking-[0.2em] text-gold uppercase"
                    >
                      {post.data.category}
                    </p>
                  </div>

                  <div
                    class="border-b border-charcoal/10 py-6"
                  >
                    <p
                      class="text-[7px] font-semibold tracking-[0.15em] text-charcoal/35 uppercase"
                    >
                      {
                        formatter.format(
                          post.data
                            .publishedAt
                        )
                      }
                    </p>

                    <h2
                      class="mt-4 font-serif text-3xl leading-[0.98] tracking-[-0.035em] transition-colors duration-300 group-hover:text-gold lg:text-4xl"
                    >
                      {post.data.title}
                    </h2>

                    <p
                      class="mt-5 text-sm leading-7 text-charcoal/50"
                    >
                      {post.data.excerpt}
                    </p>
                  </div>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  function initializeJournalPage() {
    const buttons =
      document.querySelectorAll<HTMLButtonElement>(
        ".journal-category"
      );

    const cards =
      document.querySelectorAll<HTMLElement>(
        ".journal-page-card"
      );

    buttons.forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const category =
            button.dataset.category ??
            "All";

          buttons.forEach(
            (currentButton) => {
              currentButton.dataset.active =
                currentButton === button
                  ? "true"
                  : "false";
            }
          );

          cards.forEach((card) => {
            const cardCategory =
              card.dataset.postCategory;

            card.hidden =
              category !== "All" &&
              cardCategory !== category;
          });
        }
      );
    });
  }

  initializeJournalPage();

  document.addEventListener(
    "astro:page-load",
    initializeJournalPage
  );
</script>