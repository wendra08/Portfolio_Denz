---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";

import {
  getCollection,
  render,
} from "astro:content";

export async function getStaticPaths() {
  const posts =
    await getCollection("journal");

  return posts
    .filter(
      (post) =>
        !post.data.draft
    )
    .map((post) => ({
      params: {
        id: post.id,
      },

      props: {
        post,
      },
    }));
}

const { post } = Astro.props;

const { Content } =
  await render(post);

const formatter =
  new Intl.DateTimeFormat("id-ID", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });
---

<BaseLayout
  title={`${post.data.title} — Kang Denz`}
  description={post.data.excerpt}
>
  <Navbar />

  <main
    class="min-h-screen bg-ivory text-charcoal"
  >
    <!-- ARTICLE HEADER -->

    <header
      class="pt-36 md:pt-44"
    >
      <div class="container-luxury">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <a
            href="/journal"
            class="group inline-flex items-center gap-3 text-[8px] font-bold tracking-[0.18em] text-charcoal/45 uppercase transition-colors hover:text-gold"
          >
            <span
              class="transition-transform group-hover:-translate-x-1"
            >
              ←
            </span>

            Journal
          </a>

          <a
            href="/"
            class="group inline-flex items-center gap-3 text-[8px] font-bold tracking-[0.18em] text-charcoal/45 uppercase transition-colors hover:text-gold"
          >
            <span
              class="transition-transform group-hover:-translate-x-1"
            >
              ←
            </span>

            Back To Home
          </a>
        </div>

        <div
          class="mt-10 grid gap-10 lg:grid-cols-[1.4fr_0.6fr] lg:items-end lg:gap-20"
        >
          <div>
            <p
              class="text-[8px] font-bold tracking-[0.22em] text-gold uppercase"
            >
              {post.data.category}
            </p>

            <h1
              class="mt-5 max-w-6xl font-serif text-[clamp(3.5rem,7vw,7rem)] leading-[0.88] tracking-[-0.05em]"
            >
              {post.data.title}
            </h1>
          </div>

          <div>
            <p
              class="text-sm leading-7 text-charcoal/55 md:text-base"
            >
              {post.data.excerpt}
            </p>

            <div
              class="mt-7 border-t border-charcoal/10 pt-5"
            >
              <div
                class="flex flex-wrap gap-x-5 gap-y-2 text-[7px] font-semibold tracking-[0.16em] text-charcoal/35 uppercase"
              >
                <span>
                  {
                    formatter.format(
                      post.data.publishedAt
                    )
                  }
                </span>

                <span>
                  {post.data.author}
                </span>

                {
                  post.data.readTime && (
                    <span>
                      {post.data.readTime}
                    </span>
                  )
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- COVER -->

    <div
      class="container-luxury mt-14 md:mt-20"
    >
      <div
        class="relative aspect-[4/5] overflow-hidden bg-charcoal sm:aspect-[16/10] lg:aspect-[16/7]"
      >
        <img
          src={post.data.cover}
          alt={post.data.title}
          class="h-full w-full object-cover"
        />

        <div
          class="absolute inset-0 bg-black/10"
        ></div>
      </div>
    </div>

    <!-- CONTENT -->

    <article
      class="container-luxury py-16 md:py-24 lg:py-28"
    >
      <div
        class="journal-prose mx-auto max-w-[760px]"
      >
        <Content />
      </div>
    </article>

    <!-- BACK -->

    <div
      class="container-luxury border-t border-charcoal/10 py-12"
    >
      <a
        href="/journal"
        class="group inline-flex items-center gap-4 text-[8px] font-bold tracking-[0.18em] uppercase"
      >
        <span
          class="transition-transform group-hover:-translate-x-1"
        >
          ←
        </span>

        Back To Journal
      </a>
    </div>
  </main>
</BaseLayout>