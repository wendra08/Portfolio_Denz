---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Photo from "../../components/Photo.astro";
import { projects } from "../../data/portfolio";
---

<BaseLayout title="Wedding Portfolio — Kang Denz" description="Jelajahi dokumentasi wedding reception, akad, dan perayaan pernikahan dalam portfolio Wedding MC Kang Denz.">
  <Navbar />
  <main id="main-content" tabindex="-1" class="bg-ivory text-charcoal">
    <section class="container-luxury pt-36 pb-16 md:pt-44 md:pb-24">
      <div class="flex flex-wrap items-center justify-between gap-5">
        <p class="gold-label">Wedding Portfolio</p>
        <a href="/#portfolio" class="py-3 text-xs font-semibold text-charcoal/70 hover:text-gold">← Kembali ke beranda</a>
      </div>
      <h1 class="mt-8 max-w-5xl font-serif text-[clamp(2.75rem,7vw,7rem)] leading-[0.95] tracking-[-0.04em]">Every wedding,{' '}<span class="text-gold">a different story.</span></h1>
      <p class="mt-8 max-w-xl text-base leading-8 text-charcoal/70">Dokumentasi pilihan dari perjalanan Kang Denz sebagai Wedding MC. Temukan momen resepsi, akad, dan perayaan dengan karakter masing-masing.</p>
      <p class="mt-6 text-xs tracking-[0.15em] text-charcoal/70 uppercase">{projects.length} selected stories</p>
    </section>

    <section aria-label="Daftar wedding story" class="container-luxury grid gap-x-8 gap-y-14 border-t border-charcoal/15 py-14 md:grid-cols-2 lg:grid-cols-3 md:py-20">
      {projects.map((project) => (
        <article>
          <a href={`/portfolio/${project.slug}`} class="group block">
            <div class="relative aspect-[4/5] overflow-hidden bg-charcoal">
              <Photo src={project.image} alt={`${project.title} — ${project.location}`} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
              <span class="absolute top-5 left-5 border border-white/30 bg-charcoal/70 px-3 py-2 text-xs tracking-widest text-ivory">{project.number}</span>
            </div>
            <p class="mt-6 text-xs tracking-[0.15em] text-charcoal/70 uppercase">{project.location} · {project.year}</p>
            <h2 class="mt-3 font-serif text-4xl leading-tight tracking-[-0.03em] group-hover:text-gold">{project.title}</h2>
            <p class="mt-4 text-sm leading-7 text-charcoal/70">{project.description}</p>
            <span class="mt-6 inline-flex min-h-11 items-center gap-4 text-xs font-semibold tracking-[0.1em] uppercase">View Wedding Story <span aria-hidden="true">→</span></span>
          </a>
        </article>
      ))}
    </section>

    <section class="border-t border-charcoal/15">
      <div class="container-luxury flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between md:py-24">
        <div>
          <p class="gold-label">Your Story Is Next</p>
          <h2 class="mt-5 max-w-2xl font-serif text-4xl leading-tight md:text-5xl">Mari bicarakan{' '}<span class="text-gold">rencana acaramu.</span></h2>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
